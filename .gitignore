node_modules/
dist/
.astro/
.npm/
.pnpm-store/
.wrangler/

# ── Python / Backend ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
