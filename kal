#!/usr/bin/env python3
"""kal — Kalolsavam deployment & operations CLI."""
import argparse, getpass, json, os, re, secrets, shutil, subprocess, sys, time, urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent
while not (ROOT / "docker-compose.yml").exists() and ROOT != ROOT.parent:
    ROOT = ROOT.parent
if not (ROOT / "docker-compose.yml").exists():
    print("kal: cannot find docker-compose.yml — run from within the project.", file=sys.stderr)
    sys.exit(2)

ENV_FILE = ROOT / ".env"
ENV_EXAMPLE = ROOT / ".env.example"
DEPLOYMENT_DIR = ROOT / "deployment"
LOCK_PATH = ROOT / ".kal.lock"
HEALTH_URL = "http://127.0.0.1:8000/healthz"
READY_URL = "http://127.0.0.1:8000/readyz"

STATE_MODIFYING = {
    "init", "up", "down", "restart", "deploy", "rebuild",
    "token", "tunnel", "admin", "db", "clean", "reset", "env",
}

def _tty(): return sys.stdout.isatty() and sys.stderr.isatty()
def c(code, text): return f"\033[{code}m{text}\033[0m" if _tty() else text
def red(t): return c("31", t)
def green(t): return c("32", t)
def yellow(t): return c("33", t)
def blue(t): return c("34", t)
def cyan(t): return c("36", t)
def bold(t): return c("1", t)
def dim(t): return c("2", t)
def info(m): print(f"{blue('•')} {m}")
def ok(m): print(f"{green('✓')} {m}")
def warn(m): print(f"{yellow('!')} {m}", file=sys.stderr)
def err(m): print(f"{red('✗')} {m}", file=sys.stderr)
def die(m, code=1): err(m); sys.exit(code)
def banner(): print(bold(cyan("Kalolsavam")) + dim(" · deployment CLI"))
def section(t): print(); print(bold(t)); print(dim("─" * len(t)))

class EnvFile:
    def __init__(self, path):
        self.path = path
        self.lines = path.read_text().splitlines() if path.exists() else []
    def get(self, key, default=None):
        for line in self.lines:
            s = line.strip()
            if not s or s.startswith("#") or "=" not in s: continue
            k, _, v = s.partition("=")
            if k.strip() == key:
                v = v.strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'": v = v[1:-1]
                return v
        return default
    def set(self, key, value):
        out, found = [], False
        for line in self.lines:
            s = line.strip()
            if s and not s.startswith("#") and "=" in s:
                if s.split("=", 1)[0].strip() == key:
                    out.append(f"{key}={_quote(value)}"); found = True; continue
            out.append(line)
        if not found: out.append(f"{key}={_quote(value)}")
        self.lines = out; self._save()
    def unset(self, key):
        self.lines = [l for l in self.lines
                      if not (l.strip() and not l.strip().startswith("#")
                              and "=" in l and l.split("=", 1)[0].strip() == key)]
        self._save()
    def all(self):
        out = {}
        for line in self.lines:
            s = line.strip()
            if not s or s.startswith("#") or "=" not in s: continue
            k, _, v = s.partition("=")
            v = v.strip()
            if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'": v = v[1:-1]
            out[k.strip()] = v
        return out
    def _save(self): self.path.write_text("\n".join(self.lines) + "\n")

def _quote(v):
    if not v: return ""
    if any(ch in v for ch in ' \t#"\'\\$'):
        return '"' + v.replace('\\', '\\\\').replace('"', '\\"').replace('$', '\\$') + '"'
    return v

def run(cmd, capture=False, timeout=None, cwd=None, env=None):
    try:
        return subprocess.run(cmd, capture_output=capture, text=True, timeout=timeout, cwd=cwd, env=env, check=False)
    except FileNotFoundError: die(f"command not found: {cmd[0]}")
    except subprocess.TimeoutExpired: die(f"command timed out: {' '.join(cmd)}")

def exec_replace(cmd):
    try: os.execvp(cmd[0], cmd)
    except FileNotFoundError: die(f"command not found: {cmd[0]}")

def acquire_lock():
    try: import fcntl
    except ImportError: return None
    f = open(LOCK_PATH, "w")
    try:
        fcntl.flock(f.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB); return f
    except BlockingIOError:
        f.close(); die("another 'kal' process is running — wait for it to finish.")

def ensure_docker():
    if not shutil.which("docker"): die("Docker is not installed. See https://docs.docker.com/get-docker/")
    if run(["docker", "info"], capture=True).returncode != 0:
        die("Docker daemon is not running or not accessible.")

def get_compose():
    if run(["docker", "compose", "version"], capture=True).returncode == 0:
        return ["docker", "compose"]
    if shutil.which("docker-compose") and run(["docker-compose", "version"], capture=True).returncode == 0:
        return ["docker-compose"]
    die("Docker Compose not available.")

def backend_running():
    r = run(get_compose() + ["ps", "--format", "json"], capture=True)
    if r.returncode != 0: return False
    for line in r.stdout.splitlines():
        line = line.strip()
        if not line: continue
        try: svc = json.loads(line)
        except json.JSONDecodeError: continue
        if svc.get("Service") == "backend":
            return (svc.get("State") or "").lower() == "running"
    return False

def tunnel_container_state():
    r = run(get_compose() + ["ps", "--all", "--format", "json"], capture=True)
    if r.returncode != 0: return "missing"
    for line in r.stdout.splitlines():
        line = line.strip()
        if not line: continue
        try: svc = json.loads(line)
        except json.JSONDecodeError: continue
        if svc.get("Service") == "tunnel":
            return (svc.get("State") or "").lower() or "unknown"
    return "missing"

def recreate_tunnel():
    compose = get_compose()
    info("force-recreating tunnel container…")
    r = run(compose + ["--profile", "tunnel", "up", "-d", "--force-recreate", "tunnel"], capture=False)
    if r.returncode != 0: return False
    time.sleep(3)
    state = tunnel_container_state()
    if state == "restarting":
        err("tunnel is restarting — likely an invalid token.")
        info("verify at: Zero Trust > Networks > Tunnels > <tunnel> > Configure > Install Connector")
        info("then: kal token set '<new token>'")
        return False
    return state == "running"

def compose_up(tunnel=False, build=True):
    ensure_docker()
    compose = get_compose()
    cmd = compose + (["--profile", "tunnel", "up", "-d"] if tunnel else ["up", "-d"])
    if build: cmd.append("--build")
    info(f"$ {' '.join(cmd)}")
    if run(cmd, capture=False).returncode != 0: die("docker compose up failed.")

def compose_down(remove_images=False, remove_volumes=False):
    ensure_docker()
    cmd = get_compose() + ["down"]
    if remove_volumes: cmd.append("-v")
    if remove_images: cmd += ["--rmi", "local"]
    run(cmd, capture=False)

def check_health(url=HEALTH_URL, timeout=3):
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r: return r.status == 200
    except Exception: return False

def wait_healthy(max_seconds=180):
    info("waiting for backend to become healthy…")
    start = time.time(); next_log = 0
    while time.time() - start < max_seconds:
        if check_health(): ok(f"backend healthy after {int(time.time() - start)}s"); return True
        time.sleep(2)
        elapsed = int(time.time() - start)
        if elapsed >= next_log + 15:
            print(dim(f"  … {elapsed}s elapsed")); next_log = elapsed
    warn(f"backend did not become healthy within {max_seconds}s")
    print(dim("  hint: run 'kal logs' to inspect.")); return False

def in_container(args, interactive=False):
    if not backend_running(): die("backend container is not running — start it with 'kal up' first.")
    cmd = get_compose() + ["exec"]
    if not interactive: cmd.append("-T")
    cmd += ["backend"] + args
    if interactive: exec_replace(cmd)
    return run(cmd, capture=True)

def ensure_backend_running():
    if backend_running(): return
    warn("backend is not running.")
    if confirm("start it now?", default=True):
        cmd_up(argparse.Namespace(tunnel=False, no_build=False))
        if not backend_running(): die("failed to start backend.")
    else: die("backend must be running for this operation.")

def prompt(text, default=None, secret=False, allow_empty=False, validate=None, show_length=False):
    suffix = f" [{default}]" if default not in (None, "") else ""
    while True:
        try:
            if secret: val = getpass.getpass(f"{text}{suffix}: ")
            else: val = input(f"{text}{suffix}: ")
        except (EOFError, KeyboardInterrupt): print(); die("aborted.")
        except Exception as exc:
            warn(f"input error: {exc} - retrying with visible input")
            try: val = input(f"{text}{suffix}: ")
            except EOFError: die("aborted.")
        val = val.strip()
        if secret or show_length: print(dim(f"  (received {len(val)} chars)"))
        if not val:
            if default is not None: return default
            if allow_empty: return ""
            warn("a value is required."); continue
        if validate:
            good, msg = validate(val)
            if not good: warn(msg); continue
        return val

def confirm(text, default=False):
    suffix = " [Y/n]" if default else " [y/N]"
    try: val = input(f"{text}{suffix}: ").strip().lower()
    except EOFError: return default
    if not val: return default
    return val in ("y", "yes")

def validate_email(v):
    if re.match(r"^[^@\s]+@[^@\s]+\.[^@\s]+$", v): return True, ""
    return False, "not a valid email."

def validate_password(v):
    if len(v) < 12: return False, "password must be at least 12 characters."
    return True, ""

_UUID_RE = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")

def extract_token(raw):
    if not raw: return None, "empty input"
    v = raw.strip()
    m = re.search(r"--token[\s=]+(\S+)", v)
    if m: v = m.group(1).strip("\"'")
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'": v = v[1:-1]
    return v, None

def validate_token(v):
    v, _ = extract_token(v) if v else (None, None)
    if not v: return False, "no token found in input."
    n = len(v)
    if _UUID_RE.match(v):
        return False, (
            f"that is a Cloudflare Tunnel ID (UUID, {n} chars), not the connector token.\n"
            "  In Zero Trust > Networks > Tunnels > <your tunnel> > Configure > Install Connector > Docker tab,\n"
            "  copy the long string after `--token` (starts with `eyJ...`, typically 150-200 chars)."
        )
    if not v.startswith("eyJ"):
        return False, (
            f"that does not look like a tunnel token (received {n} chars, starts with {v[:6]!r}; tokens start with 'eyJ'). "
            "did you paste the connector command or just the ID?"
        )
    if n < 100:
        return False, (
            f"token looks truncated (received {n} chars; Cloudflare tokens are typically 150-200 chars). "
            "retry with --token-file to bypass terminal paste limits."
        )
    bad = [ch for ch in v if not re.match(r"[A-Za-z0-9._+/=-]", ch)]
    if bad:
        return False, f"token contains {len(bad)} unexpected char(s): {''.join(bad[:5])!r} (received {n} chars)."
    return True, ""

def _resolve_token(args):
    for src, getter in (
        ("--token", lambda: (getattr(args, "token", None) or "").strip()),
        ("KAL_TUNNEL_TOKEN", lambda: os.environ.get("KAL_TUNNEL_TOKEN", "").strip()),
    ):
        raw = getter()
        if raw:
            tok, _ = extract_token(raw)
            good, why = validate_token(tok or raw)
            if not good: die(f"{src} invalid: {why}")
            return tok
    tf = getattr(args, "token_file", None)
    if tf:
        try: raw = Path(tf).expanduser().read_text().strip()
        except Exception as e: die(f"could not read --token-file {tf}: {e}")
        tok, _ = extract_token(raw)
        good, why = validate_token(tok or raw)
        if not good: die(f"--token-file content invalid: {why}")
        return tok
    return None

def _mask(v, visible=4):
    if not v: return ""
    if len(v) <= visible * 2: return "***"
    return v[:visible] + "…" + v[-visible:]

def _is_secret(k):
    return any(w in k.upper() for w in ("SECRET", "PASSWORD", "TOKEN", "KEY"))

def _fmt_bytes(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024: return f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} TB"

def _ensure_env():
    if ENV_FILE.exists(): return
    if not ENV_EXAMPLE.exists(): die(f"neither {ENV_FILE.name} nor {ENV_EXAMPLE.name} exists.")
    ENV_FILE.write_text(ENV_EXAMPLE.read_text())
    info(f"created {ENV_FILE.name} from {ENV_EXAMPLE.name}")

def _ensure_secret():
    env = EnvFile(ENV_FILE)
    if env.get("SECRET_KEY", "").strip(): return
    if (DEPLOYMENT_DIR / "secret.key").exists(): return
    env.set("SECRET_KEY", secrets.token_urlsafe(48))
    ok("generated SECRET_KEY in .env")

def _print_urls():
    origin = EnvFile(ENV_FILE).get("PUBLIC_ORIGIN", "http://localhost:8000").rstrip("/")
    print()
    ok(f"site:         {origin}/")
    ok(f"admin:        {origin}/admin/")
    ok(f"stagemaster:  {origin}/stagemaster/")
    ok(f"dashboard:    {origin}/dashboard/")

def cmd_init(args):
    banner()
    ensure_docker()
    print("This wizard configures .env and starts the stack.\n")
    if ENV_FILE.exists() and not args.force:
        warn(f"{ENV_FILE.name} already exists.")
        if not confirm("overwrite it?", default=False):
            info("keeping existing .env — running 'kal up' instead.")
            return cmd_up(argparse.Namespace(tunnel=False, no_build=False))
    if not ENV_EXAMPLE.exists(): die(f"{ENV_EXAMPLE.name} missing — cannot initialize.")
    ENV_FILE.write_text(ENV_EXAMPLE.read_text())
    env = EnvFile(ENV_FILE)

    section("1. Public origin")
    origin = prompt("public origin (protocol + host)", default="http://localhost:8000")
    if not origin.startswith(("http://", "https://")): die("origin must start with http:// or https://")
    env.set("PUBLIC_ORIGIN", origin)

    section("2. Secret key")
    env.set("SECRET_KEY", secrets.token_urlsafe(48))
    ok("generated SECRET_KEY.")

    section("3. Administrator")
    admin_email = prompt("admin email", default="admin@kalolsavam.example.com", validate=validate_email)
    env.set("ADMIN_EMAIL", admin_email)

    preset_pw = (getattr(args, "admin_password", None) or os.environ.get("KAL_ADMIN_PASSWORD", "")).strip()
    if preset_pw:
        good, why = validate_password(preset_pw)
        if not good: die(f"preset admin password invalid: {why}")
        env.set("ADMIN_PASSWORD", preset_pw)
        ok(f"admin password set from arg/env ({len(preset_pw)} chars).")
        set_pass = True
    elif confirm("set an admin password now?", default=True):
        while True:
            p1 = prompt("admin password (12+ chars)", secret=True, validate=validate_password)
            p2 = prompt("confirm password", secret=True)
            if p1 != p2: warn("passwords do not match."); continue
            env.set("ADMIN_PASSWORD", p1); ok("admin password stored in .env."); break
        set_pass = True
    else:
        info("no password set - one will be generated on first boot; run 'kal logs backend' to read it.")
        set_pass = False

    section("4. Cloudflare Tunnel (optional)")
    use_tunnel = False
    token_val = _resolve_token(args)
    if token_val is not None:
        env.set("CLOUDFLARE_TUNNEL_TOKEN", token_val)
        ok(f"tunnel token saved from arg/env/file ({len(token_val)} chars).")
        use_tunnel = True
    elif confirm("configure Cloudflare Tunnel now?", default=False):
        print(dim("  hint: Zero Trust > Networks > Tunnels > <name> > Configure > Install Connector > Docker."))
        print(dim("        paste the string after `--token` (starts with 'eyJ...'), or the whole docker run command."))
        while True:
            try: raw = input("tunnel token (visible paste; Ctrl+C to skip): ")
            except (EOFError, KeyboardInterrupt):
                print(); info("skipped tunnel setup."); break
            raw = raw.strip()
            print(dim(f"  (received {len(raw)} chars)"))
            if not raw: warn("empty input - paste token, or Ctrl+C to skip."); continue
            tok, _ = extract_token(raw)
            good, why = validate_token(tok or raw)
            if not good:
                warn(why)
                if confirm("retry?", default=True): continue
                info("skipped tunnel setup."); break
            env.set("CLOUDFLARE_TUNNEL_TOKEN", tok)
            ok(f"tunnel token saved ({len(tok)} chars).")
            use_tunnel = True; break

    section("5. Starting stack")
    compose_up(tunnel=use_tunnel, build=True)
    if use_tunnel:
        if not recreate_tunnel(): return 1
    if not wait_healthy(): die("setup failed — backend never became healthy. see 'kal logs'.")

    section("done")
    _print_urls()
    if not set_pass:
        warn("admin password was auto-generated — see 'kal logs backend' on first boot.")
    return 0

def cmd_up(args):
    banner()
    ensure_docker(); _ensure_env(); _ensure_secret()
    tunnel = getattr(args, "tunnel", False)
    build = not getattr(args, "no_build", False)
    if tunnel:
        tok = EnvFile(ENV_FILE).get("CLOUDFLARE_TUNNEL_TOKEN", "").strip()
        if not tok:
            die("--tunnel requested but CLOUDFLARE_TUNNEL_TOKEN is empty.\n  run: kal token set '<token>'")
        good, why = validate_token(tok)
        if not good: die(f"CLOUDFLARE_TUNNEL_TOKEN is invalid: {why}")
    compose_up(tunnel=tunnel, build=build)
    if tunnel and not recreate_tunnel(): return 1
    if not wait_healthy(): return 1
    _print_urls()
    if tunnel: info(f"tunnel state: {tunnel_container_state()}")
    return 0

def cmd_down(args):
    banner(); compose_down(); ok("stopped."); return 0

def cmd_restart(args):
    banner(); ensure_docker()
    if not backend_running(): die("backend is not running — use 'kal up'.")
    # 'docker compose restart' does NOT reload .env changes.
    info("recreating backend container (picks up .env changes)…")
    if run(get_compose() + ["up", "-d", "--force-recreate", "backend"], capture=False).returncode != 0: 
        die("restart failed.")
    if not wait_healthy(): return 1
    ok("restarted."); return 0

def cmd_status(args):
    banner(); ensure_docker()
    run(get_compose() + ["ps"], capture=False); print()
    (ok if check_health() else warn)("healthz: " + ("OK" if check_health() else "unreachable"))
    (ok if check_health(READY_URL) else warn)("readyz: " + ("OK" if check_health(READY_URL) else "not ready"))
    state = tunnel_container_state()
    if state == "running": ok("tunnel: running")
    elif state == "restarting": warn("tunnel: restarting (likely invalid token — run 'kal tunnel logs')")
    elif state == "missing": info("tunnel: not started (optional; 'kal up --tunnel' to start)")
    else: warn(f"tunnel: {state}")
    db = DEPLOYMENT_DIR / "kalolsavam.db"
    if db.exists(): print(f"{blue('•')} db: {db.name} ({_fmt_bytes(db.stat().st_size)})")
    return 0

def cmd_logs(args):
    ensure_docker()
    cmd = get_compose() + ["logs", "--tail", "200"]
    if args.follow: cmd.append("-f")
    cmd.append(args.service); exec_replace(cmd)

def cmd_shell(args):
    ensure_docker(); exec_replace(get_compose() + ["exec", "backend", "bash"])

def cmd_token(args):
    banner(); _ensure_env()
    env = EnvFile(ENV_FILE)
    action = args.token_action or "get"
    if action == "get":
        tok = env.get("CLOUDFLARE_TUNNEL_TOKEN", "").strip()
        if not tok: info("no tunnel token configured."); return 0
        print(f"token:  {_mask(tok)}"); print(f"length: {len(tok)}"); return 0
    if action == "set":
        raw = (args.value or "").strip()
        if not raw:
            try: raw = input("tunnel token or full `cloudflared ... --token X` command: ").strip()
            except (EOFError, KeyboardInterrupt): print(); die("aborted.")
            print(dim(f"  (received {len(raw)} chars)"))
        if not raw: die("empty token.")
        val, _ = extract_token(raw)
        good, why = validate_token(val or raw)
        if not good: die(why)
        env.set("CLOUDFLARE_TUNNEL_TOKEN", val)
        ok(f"token saved ({len(val)} chars).")
        state = tunnel_container_state()
        if state in ("running", "restarting", "exited", "created"):
            if confirm("recreate the tunnel container now?", default=True):
                if recreate_tunnel(): ok("tunnel recreated and running.")
                else: return 1
            else: info("run 'kal tunnel restart' when ready.")
        else: info("start it with: kal up --tunnel")
        return 0
    if action == "clear":
        env.unset("CLOUDFLARE_TUNNEL_TOKEN"); ok("token removed from .env.")
        if tunnel_container_state() in ("running", "restarting"):
            info("stopping tunnel container…")
            run(get_compose() + ["--profile", "tunnel", "stop", "tunnel"], capture=False)
        return 0
    die(f"unknown token action: {action}")

def cmd_tunnel(args):
    banner()
    action = args.tunnel_action or "status"
    if action == "status":
        state = tunnel_container_state()
        print(f"{blue('•')} container: {state}")
        if ENV_FILE.exists():
            tok = EnvFile(ENV_FILE).get("CLOUDFLARE_TUNNEL_TOKEN", "").strip()
            if tok:
                good, why = validate_token(tok)
                if good: ok(f"token configured ({len(tok)} chars)")
                else: warn(f"token configured but invalid: {why}")
            else: warn("no token configured in .env")
        if state == "restarting":
            warn("tunnel is in a restart loop — likely an invalid token.")
            info("run: kal tunnel logs   (inspect cloudflared output)")
            return 1
        if state == "missing": info("tunnel not started. run 'kal up --tunnel'.")
        return 0
    if action == "restart":
        ensure_docker(); _ensure_env()
        tok = EnvFile(ENV_FILE).get("CLOUDFLARE_TUNNEL_TOKEN", "").strip()
        if not tok: die("no token configured. run 'kal token set' first.")
        if recreate_tunnel(): ok("tunnel running."); return 0
        return 1
    if action == "logs":
        ensure_docker()
        cmd = get_compose() + ["logs", "--tail", "100"]
        if args.follow: cmd.append("-f")
        cmd.append("tunnel"); exec_replace(cmd)
    die(f"unknown tunnel action: {action}")

def cmd_admin(args):
    banner(); ensure_backend_running()
    action = args.admin_action or "list"
    if action == "list":
        r = in_container(["python", "-m", "server", "user-list"]); print(r.stdout or r.stderr); return 0
    if action == "create":
        pwd = args.password
        if not pwd: pwd = prompt(f"password for {args.email}", secret=True, validate=validate_password)
        role = getattr(args, "role", "admin") or "admin"
        cmd = ["python", "-m", "server", "user-create",
               "--email", args.email, "--password", pwd, "--role", role]
        stages_csv = getattr(args, "stages", None)
        if stages_csv:
            try:
                import json as _json
                ids = [int(x) for x in str(stages_csv).split(",") if x.strip()]
                cmd += ["--stages", _json.dumps(ids)]
            except ValueError:
                err(f"invalid --stages value: {stages_csv}")
                return 1
        r = in_container(cmd)
        print(r.stdout or r.stderr); return 0
    if action == "password":
        pwd = args.password
        if not pwd: pwd = prompt(f"new password for {args.email}", secret=True, validate=validate_password)
        r = in_container(["python", "-m", "server", "user-reset-password", "--email", args.email, "--password", pwd])
        print(r.stdout or r.stderr); return 0
    if action == "delete":
        if not args.yes and not confirm(f"delete {args.email}?", default=False):
            info("cancelled."); return 0
        r = in_container(["python", "-m", "server", "user-delete", "--email", args.email, "--yes"])
        print(r.stdout or r.stderr); return 0
    if action == "enable":
        r = in_container(["python", "-m", "server", "user-enable", "--email", args.email]); print(r.stdout or r.stderr); return 0
    if action == "disable":
        r = in_container(["python", "-m", "server", "user-disable", "--email", args.email]); print(r.stdout or r.stderr); return 0
    die(f"unknown admin action: {action}")

def cmd_db(args):
