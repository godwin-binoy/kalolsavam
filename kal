def cmd_doctor(args):
    banner(); failures = 0
    def chk(label, fn):
        nonlocal failures
        try:
            res = fn()
            if res is True: ok(label)
            elif res is False: err(label); failures += 1
            else: warn(f"{label}: {res}")
        except Exception as e: err(f"{label}: {e}"); failures += 1
    print(bold("environment checks") + "\n")
    chk("docker installed", lambda: bool(shutil.which("docker")))
    chk("docker daemon running", lambda: run(["docker", "info"], capture=True).returncode == 0)
    chk("docker compose available", lambda: get_compose() is not None)
    chk(".env exists", lambda: ENV_FILE.exists())
    def _secret_ok():
        if not ENV_FILE.exists(): return False
        return (bool(EnvFile(ENV_FILE).get("SECRET_KEY", "").strip()) or (DEPLOYMENT_DIR / "secret.key").exists())
    chk("SECRET_KEY configured", _secret_ok)
    def _admin_email_ok():
        if not ENV_FILE.exists(): return False
        return bool(EnvFile(ENV_FILE).get("ADMIN_EMAIL", "").strip())
    chk("ADMIN_EMAIL set", _admin_email_ok)
    def _origin_ok():
        if not ENV_FILE.exists(): return False
        o = EnvFile(ENV_FILE).get("PUBLIC_ORIGIN", "")
        return o.startswith(("http://", "https://")) or f"invalid PUBLIC_ORIGIN: {o!r}"
    chk("PUBLIC_ORIGIN valid", _origin_ok)
    chk("deployment/ dir exists", lambda: DEPLOYMENT_DIR.exists())
    chk("backend container running", lambda: backend_running())
    chk("backend /healthz OK", lambda: check_health())
    def _tunnel_ok():
        st = tunnel_container_state()
        if st in ("missing", "running"): return True
        if st == "restarting": return "restart loop — 'kal tunnel logs'; token likely invalid"
        return st
    chk("cloudflare tunnel", _tunnel_ok)
    def _port_check():
        import socket
        s = socket.socket(); s.settimeout(1)
        try: rc = s.connect_ex(("127.0.0.1", 8000))
        finally: s.close()
        if rc != 0: return "port 8000 is free"
        return True if backend_running() else "port 8000 used by another process"
    chk("port 8000", _port_check)
    try:
        du = shutil.disk_usage(str(DEPLOYMENT_DIR))
        free_gb = du.free / (1024 ** 3)
        (ok if free_gb > 1 else warn)(f"disk free: {free_gb:.1f} GB")
    except Exception: pass
    print()
    if failures == 0: ok("all checks passed."); return 0
    warn(f"{failures} check(s) failed."); return 1

def cmd_version(args):
    banner(); print("kal CLI:      1.0.0")
    try: print(f"package.json: {json.loads((ROOT / 'package.json').read_text()).get('version','?')}")
    except Exception: pass
    try:
        m = re.search(r'__version__\s*=\s*"([^"]+)"', (ROOT / "server" / "__init__.py").read_text())
        if m: print(f"server:       {m.group(1)}")
    except Exception: pass
    r = run(["git", "-C", str(ROOT), "rev-parse", "--short", "HEAD"], capture=True)
    if r.returncode == 0:
        print(f"git HEAD:     {r.stdout.strip()}")
        if run(["git", "-C", str(ROOT), "status", "--porcelain"], capture=True).stdout.strip():
            warn("working tree has uncommitted changes")
    return 0

def cmd_env(args):
    banner(); _ensure_env()
    env = EnvFile(ENV_FILE)
    action = args.env_action or "show"
    if action == "show":
        for k, v in env.all().items():
            print(f"{k}={_mask(v) if _is_secret(k) else v}")
        return 0
    if action == "set":
        if len(args.pair) == 1:
            kv = args.pair[0]
            if "=" not in kv: die("expected KEY=VALUE")
            k, _, v = kv.partition("=")
        elif len(args.pair) == 2: k, v = args.pair
        else: die("expected KEY=VALUE or KEY VALUE")
        env.set(k.strip(), v); ok(f"set {k.strip()} — restart to apply."); return 0
    if action == "unset":
        env.unset(args.key); ok(f"unset {args.key}."); return 0
    die(f"unknown env action: {action}")

def cmd_deploy(args):
    banner(); ensure_docker(); _ensure_env(); _ensure_secret()
    tunnel = getattr(args, "tunnel", False)
    if tunnel:
        tok = EnvFile(ENV_FILE).get("CLOUDFLARE_TUNNEL_TOKEN", "").strip()
        if not tok: die("--tunnel requested but CLOUDFLARE_TUNNEL_TOKEN is empty.")
        good, why = validate_token(tok)
        if not good: die(f"CLOUDFLARE_TUNNEL_TOKEN is invalid: {why}")
    compose_up(tunnel=tunnel, build=True)
    if tunnel and not recreate_tunnel(): return 1
    if not wait_healthy(): return 1
    _print_urls(); return 0

