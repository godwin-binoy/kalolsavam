#!/usr/bin/env python3
"""kal — Kalolsavam deployment & operations CLI."""
import argparse, getpass, json, os, secrets, shutil, subprocess, sys, time, urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent
ENV_FILE, ENV_EXAMPLE = ROOT / ".env", ROOT / ".env.example"
HEALTH_URL, READY_URL = "http://127.0.0.1:8000/healthz", "http://127.0.0.1:8000/readyz"


def die(msg, code=1):
    print(f"✗ {msg}", file=sys.stderr)
    sys.exit(code)


def run(cmd, capture=False):
    return subprocess.run(cmd, capture_output=capture, text=True, check=False)


def compose_cmd():
    if not shutil.which("docker") or run(["docker", "info"], capture=True).returncode != 0:
        die("Docker is not running or not installed.")
    if run(["docker", "compose", "version"], capture=True).returncode == 0:
        return ["docker", "compose"]
    die("Docker Compose v2 is required.")


def env_get(key, default=""):
    if not ENV_FILE.exists():
        return default
    for line in ENV_FILE.read_text().splitlines():
        s = line.strip()
        if s and not s.startswith("#") and "=" in s:
            k, _, v = s.partition("=")
            if k.strip() == key:
                return v.strip().strip("\"'")
    return default


def env_set(key, val):
    if not ENV_FILE.exists() and ENV_EXAMPLE.exists():
        ENV_FILE.write_text(ENV_EXAMPLE.read_text())
    lines = ENV_FILE.read_text().splitlines() if ENV_FILE.exists() else []
    out, found = [], False
    qval = f'"{val}"' if any(c in val for c in ' \t#"\'$') else val
    for line in lines:
        s = line.strip()
        if s and not s.startswith("#") and "=" in s and s.split("=", 1)[0].strip() == key:
            out.append(f"{key}={qval}")
            found = True
        else:
            out.append(line)
    if not found:
        out.append(f"{key}={qval}")
    ENV_FILE.write_text("\n".join(out) + "\n")


def wait_healthy(timeout=180):
    print("• waiting for backend…")
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(HEALTH_URL, timeout=3) as r:
                if r.status == 200:
                    print("✓ backend healthy")
                    return True
        except Exception:
            pass
        time.sleep(2)
    print("! backend health check timed out — run 'kal logs'", file=sys.stderr)
    return False


def cmd_init(args):
    if not ENV_FILE.exists() or args.force:
        ENV_FILE.write_text(ENV_EXAMPLE.read_text())
    origin = input(f"public origin [{env_get('PUBLIC_ORIGIN') or 'http://localhost:8000'}]: ").strip()
    if origin:
        env_set("PUBLIC_ORIGIN", origin)
    if not env_get("SECRET_KEY"):
        env_set("SECRET_KEY", secrets.token_urlsafe(48))
    email = input(f"admin email [{env_get('ADMIN_EMAIL') or 'admin@kalolsavam.example.com'}]: ").strip()
    if email:
        env_set("ADMIN_EMAIL", email)
    pw = args.admin_password or getpass.getpass("admin password (12+ chars, blank to auto-generate): ").strip()
    if pw:
        env_set("ADMIN_PASSWORD", pw)
    tok = args.token or input("Cloudflare tunnel token (optional): ").strip()
    if tok:
        env_set("CLOUDFLARE_TUNNEL_TOKEN", tok)
    args.tunnel = bool(env_get("CLOUDFLARE_TUNNEL_TOKEN"))
    args.workers = getattr(args, "workers", False)
    args.no_build = False
    return cmd_up(args)


def cmd_up(args):
    if not ENV_FILE.exists() and ENV_EXAMPLE.exists():
        ENV_FILE.write_text(ENV_EXAMPLE.read_text())
    if not env_get("SECRET_KEY"):
        env_set("SECRET_KEY", secrets.token_urlsafe(48))
    cmd = compose_cmd()
    if getattr(args, "tunnel", False):
        if not env_get("CLOUDFLARE_TUNNEL_TOKEN"):
            die("CLOUDFLARE_TUNNEL_TOKEN is empty — run: kal token set '<token>'")
        cmd += ["--profile", "tunnel"]
    if getattr(args, "workers", False):
        cmd += ["--profile", "photos", "--profile", "obs"]
    cmd += ["up", "-d"]
    if not getattr(args, "no_build", False):
        cmd.append("--build")
    if run(cmd).returncode != 0:
        die("docker compose up failed.")
    return 0 if wait_healthy() else 1


def cmd_down(_args):
    run(compose_cmd() + ["down"])


def cmd_restart(_args):
    if run(compose_cmd() + ["up", "-d", "--force-recreate", "backend"]).returncode != 0:
        die("restart failed.")
    return 0 if wait_healthy() else 1


def cmd_status(_args):
    run(compose_cmd() + ["ps"])
    return cmd_health(_args)


def cmd_logs(args):
    cmd = compose_cmd() + ["logs", "--tail", "200"] + (["-f"] if args.follow else []) + [args.service]
    os.execvp(cmd[0], cmd)


def cmd_shell(_args):
    cmd = compose_cmd() + ["exec", "backend", "bash"]
    os.execvp(cmd[0], cmd)


def cmd_token(args):
    if args.token_action == "set":
        val = (args.value or input("tunnel token: ")).strip()
        if not val:
            die("empty token.")
        env_set("CLOUDFLARE_TUNNEL_TOKEN", val)
        print("✓ token saved.")
    elif args.token_action == "clear":
        env_set("CLOUDFLARE_TUNNEL_TOKEN", "")
        print("✓ token cleared.")
    else:
        tok = env_get("CLOUDFLARE_TUNNEL_TOKEN")
        print(f"token: {tok[:6]}…{tok[-4:]}" if len(tok) > 12 else ("set" if tok else "not set"))


def cmd_admin(args):
    base = compose_cmd() + ["exec", "-T", "backend", "python", "-m", "server"]
    act = args.admin_action or "list"
    if act == "list":
        return run(base + ["user-list"]).returncode
    if act == "create":
        pw = args.password or getpass.getpass(f"password for {args.email}: ")
        cmd = base + ["user-create", "--email", args.email, "--password", pw, "--role", args.role]
        if args.stages:
            cmd += ["--stages", json.dumps([int(x) for x in args.stages.split(",") if x.strip()])]
        return run(cmd).returncode
    if act == "password":
        pw = args.password or getpass.getpass(f"new password for {args.email}: ")
        return run(base + ["user-reset-password", "--email", args.email, "--password", pw]).returncode
    if act in ("enable", "disable", "delete"):
        extra = ["--yes"] if act == "delete" else []
        return run(base + [f"user-{act}", "--email", args.email] + extra).returncode
    die(f"unknown admin action: {act}")


def cmd_db(args):
    act = args.db_action or "check"
    if act == "shell":
        cmd = compose_cmd() + ["exec", "backend", "sqlite3", "-header", "/app/deployment/kalolsavam.db"]
        os.execvp(cmd[0], cmd)
    return run(compose_cmd() + ["exec", "-T", "backend", "python", "-m", "server", act]).returncode


def cmd_health(_args):
    for name, url in (("healthz", HEALTH_URL), ("readyz", READY_URL)):
        try:
            with urllib.request.urlopen(url, timeout=3) as r:
                print(f"✓ {name}: {r.read().decode()}")
        except Exception as e:
            print(f"✗ {name}: {e}")
            return 1
    return 0


def main():
    p = argparse.ArgumentParser(prog="kal", description="Kalolsavam CLI")
    sub = p.add_subparsers(dest="command")
    pi = sub.add_parser("init")
    pi.add_argument("--force", action="store_true")
    pi.add_argument("--token")
    pi.add_argument("--admin-password")
    pu = sub.add_parser("up")
    pu.add_argument("--tunnel", action="store_true")
    pu.add_argument("--workers", action="store_true")
    pu.add_argument("--no-build", action="store_true")
    for name in ("down", "restart", "status", "shell", "health"):
        sub.add_parser(name)
    pl = sub.add_parser("logs")
    pl.add_argument("service", nargs="?", default="backend")
    pl.add_argument("-f", "--follow", action="store_true")
    pt = sub.add_parser("token").add_subparsers(dest="token_action")
    pt.add_parser("get")
    pt.add_parser("clear")
    pts = pt.add_parser("set")
    pts.add_argument("value", nargs="?")
    pa = sub.add_parser("admin").add_subparsers(dest="admin_action")
    pa.add_parser("list")
    pac = pa.add_parser("create")
    pac.add_argument("email")
    pac.add_argument("--password", "-p")
    pac.add_argument("--role", default="admin", choices=["admin", "stagemaster", "dataworker"])
    pac.add_argument("--stages")
    pap = pa.add_parser("password")
    pap.add_argument("email")
    pap.add_argument("--password", "-p")
    for name in ("enable", "disable", "delete"):
        sub_p = pa.add_parser(name)
        sub_p.add_argument("email")
    pd = sub.add_parser("db").add_subparsers(dest="db_action")
    for name in ("migrate", "seed-stages", "backup", "check", "shell"):
        pd.add_parser(name)

    args = p.parse_args()
    if not args.command:
        p.print_help()
        return 0
    return globals()[f"cmd_{args.command}"](args) or 0


if __name__ == "__main__":
    sys.exit(main())
