def cmd_reset(args):
    banner()
    if not args.yes_i_mean_it: die("this will delete ALL data. pass --yes-i-mean-it to proceed.")
    if not confirm("really wipe everything?", default=False): info("cancelled."); return 0
    ensure_docker(); compose_down(remove_images=True, remove_volumes=True)
    for f in list(DEPLOYMENT_DIR.glob("kalolsavam*.db*")):
        try: f.unlink()
        except OSError: pass
    for f in list(DEPLOYMENT_DIR.glob("secret.key")):
        try: f.unlink()
        except OSError: pass
    ok("reset complete."); return 0

def _db_restore(file_path, skip_confirm):
    src = Path(file_path).expanduser().resolve()
    if not src.is_file(): die(f"backup not found or not a file: {src}")
    target = DEPLOYMENT_DIR / "kalolsavam.db"
    if not skip_confirm and target.exists():
        if not confirm(f"overwrite {target.name}?", default=False): info("cancelled."); return
    compose = get_compose()
    info("stopping backend…"); run(compose + ["stop", "backend"], capture=False)
    if target.exists():
        ts = time.strftime("%Y%m%d-%H%M%S")
        bak = target.with_name(f"{target.stem}-pre-restore-{ts}.db")
        shutil.copy2(target, bak); info(f"snapshot: {bak.name}")
    shutil.copy2(src, target); ok("database restored.")
    info("restarting backend…"); run(compose + ["start", "backend"], capture=False); wait_healthy()

def _db_reset(skip_confirm):
    target = DEPLOYMENT_DIR / "kalolsavam.db"
    if not target.exists(): info("no database to reset."); return
    if not skip_confirm:
        warn(f"this will DELETE {target}")
        if not confirm("proceed?", default=False): info("cancelled."); return
    compose = get_compose()
    info("stopping backend…"); run(compose + ["stop", "backend"], capture=False)
    for suffix in ("", "-wal", "-shm"):
        p = target.with_name(target.name + suffix)
        try: p.unlink()
        except FileNotFoundError: pass
    ok("database deleted.")
    info("recreating schema on restart…"); run(compose + ["start", "backend"], capture=False); wait_healthy()

def build_parser():
    p = argparse.ArgumentParser(prog="kal", description="Kalolsavam deployment & operations CLI")
    sub = p.add_subparsers(dest="command")
    p_init = sub.add_parser("init", help="first-time setup wizard")
    p_init.add_argument("--force", action="store_true")
    p_init.add_argument("--token", help="Cloudflare Tunnel token (skips prompt)")
    p_init.add_argument("--token-file", help="file containing the tunnel token")
    p_init.add_argument("--admin-password", help="admin password (skips prompt)")
    p_up = sub.add_parser("up", help="start the stack")
    p_up.add_argument("--tunnel", action="store_true")
    p_up.add_argument("--no-build", action="store_true")
    sub.add_parser("down"); sub.add_parser("restart"); sub.add_parser("status")
    p_logs = sub.add_parser("logs"); p_logs.add_argument("service", nargs="?", default="backend"); p_logs.add_argument("-f", "--follow", action="store_true")
    sub.add_parser("shell")
    p_tok = sub.add_parser("token"); tok = p_tok.add_subparsers(dest="token_action")
    t_set = tok.add_parser("set"); t_set.add_argument("value", nargs="?")
    tok.add_parser("get"); tok.add_parser("clear")
    p_tun = sub.add_parser("tunnel"); tun = p_tun.add_subparsers(dest="tunnel_action")
    tun.add_parser("status"); tun.add_parser("restart")
    t_logs = tun.add_parser("logs"); t_logs.add_argument("-f", "--follow", action="store_true")
    p_admin = sub.add_parser("admin"); adm = p_admin.add_subparsers(dest="admin_action")
    adm.add_parser("list")
    a_create = adm.add_parser("create"); a_create.add_argument("email"); a_create.add_argument("--password", "-p"); a_create.add_argument("--role", default="admin", choices=["admin", "stagemaster"]); a_create.add_argument("--stages", help="comma-separated stage numbers (e.g. 1,2,3)")
    a_pass = adm.add_parser("password"); a_pass.add_argument("email"); a_pass.add_argument("--password", "-p")
    a_del = adm.add_parser("delete"); a_del.add_argument("email"); a_del.add_argument("--yes", "-y", action="store_true")
    a_ena = adm.add_parser("enable"); a_ena.add_argument("email")
    a_dis = adm.add_parser("disable"); a_dis.add_argument("email")
    p_db = sub.add_parser("db"); db = p_db.add_subparsers(dest="db_action")
    for name in ("migrate", "seed-stages", "backup", "check", "shell"): db.add_parser(name)
    d_restore = db.add_parser("restore"); d_restore.add_argument("file"); d_restore.add_argument("--yes", "-y", action="store_true")
    d_reset = db.add_parser("reset"); d_reset.add_argument("--yes", "-y", action="store_true")
    p_dep = sub.add_parser("deploy"); p_dep.add_argument("--tunnel", action="store_true")
    sub.add_parser("rebuild"); sub.add_parser("health"); sub.add_parser("doctor"); sub.add_parser("version")
    p_env = sub.add_parser("env"); env = p_env.add_subparsers(dest="env_action")
    env.add_parser("show")
    e_set = env.add_parser("set"); e_set.add_argument("pair", nargs="+")
    e_unset = env.add_parser("unset"); e_unset.add_argument("key")
    p_clean = sub.add_parser("clean"); p_clean.add_argument("--images", action="store_true"); p_clean.add_argument("--volumes", action="store_true")
    p_reset = sub.add_parser("reset"); p_reset.add_argument("--yes-i-mean-it", action="store_true", dest="yes_i_mean_it")
    return p

HANDLERS = {
    "init": cmd_init, "up": cmd_up, "down": cmd_down, "restart": cmd_restart,
    "status": cmd_status, "logs": cmd_logs, "shell": cmd_shell,
    "token": cmd_token, "tunnel": cmd_tunnel, "admin": cmd_admin, "db": cmd_db,
    "deploy": cmd_deploy, "rebuild": cmd_rebuild,
    "health": cmd_health, "doctor": cmd_doctor, "version": cmd_version,
    "env": cmd_env, "clean": cmd_clean, "reset": cmd_reset,
}

def main():
    parser = build_parser()
    args = parser.parse_args()
    if not args.command: parser.print_help(); return 0
    handler = HANDLERS.get(args.command)
    if not handler: die(f"unknown command: {args.command}")
    lock = acquire_lock() if args.command in STATE_MODIFYING else None
    try: return handler(args) or 0
    except KeyboardInterrupt: print(); warn("interrupted."); return 130
    finally:
        if lock:
            try: lock.close()
            except Exception: pass

if __name__ == "__main__":
    sys.exit(main())
