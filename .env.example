# ===== server runtime (NEVER commit the real .env) =====
# Copy to .env and fill in. Generate values with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Comma-separated kid:seed pairs for Ed25519 JWT signing (rotate by adding a kid)
SESSION_SIGNING_SEEDS=

# LEGACY (optional): old AES-GCM key for TOTP blobs written before the
# no-DB-encryption policy. Only needed to auto-migrate an existing database;
# leave empty for new installs — the database itself is never encrypted.
DB_FIELD_KEY=

# Bind — loopback only. The Cloudflare tunnel (cloudflared) runs on this same
# box and connects to us over 127.0.0.1; there is no LAN access any more.
SERVER_HOST=127.0.0.1
SERVER_PORT=8443

# TLS is terminated at Cloudflare's edge — no local certs needed.
# Set FORCE_TLS=1 (+ paths below) ONLY if you front us with your own HTTPS
# reverse proxy instead of the tunnel.
FORCE_TLS=0
#TLS_CERT_PATH=
#TLS_KEY_PATH=

# Must stay 1 behind the tunnel: real visitor IPs come from CF-Connecting-IP.
# Production refuses to boot with TRUST_PROXY=0.
TRUST_PROXY=1

# Optional WAN allowlist for /api/admin/* (CIDRs matched against the REAL
# visitor IP). Leave empty — protection comes from auth (SRP + JWT + TOTP)
# and rate limits. Do NOT put LAN ranges here; they can't work via the tunnel.
ADMIN_IP_ALLOWLIST=

# Session policy
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_HOURS=8
IDLE_LOCK_MIN=30

# Production mode: "production" enables the startup safety checks (loopback
# bind without FORCE_TLS, TRUST_PROXY=1). Leave unset/"development" locally.
#ENVIRONMENT=production

# Official results live on the government site — we only redirect there.
RESULTS_REDIRECT_URL=https://kalolsavam.kerala.gov.in/

# Public website origin (GitHub Pages), used for CORS/audit labels if needed.
#PUBLIC_SITE_ORIGIN=https://<org>.github.io/<repo>

# Optional cosmetic path suffix for dashboard mounts (/admin-7f3a etc.).
# Convenience only — NEVER a security boundary.
#DASHBOARD_PATH_SALT=
