# ===== server runtime (NEVER commit the real .env) =====
# Copy to .env and fill in. Generate values with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Comma-separated kid:seed pairs for Ed25519 JWT signing (rotate by adding a kid)
SESSION_SIGNING_SEEDS=

# LEGACY (optional): old AES-GCM key for TOTP blobs written before the
# no-DB-encryption policy. Only needed to auto-migrate an existing database;
# leave empty for new installs — the database itself is never encrypted.
DB_FIELD_KEY=

# Bind — LAN IP only; never 0.0.0.0 without reverse proxy + firewall
SERVER_HOST=192.168.4.1
SERVER_PORT=8443
TLS_CERT_PATH=server/certs/server.pem
TLS_KEY_PATH=server/certs/server.key

# Staff VLAN allowlist for /api/admin/* (CIDR, comma-separated)
ADMIN_IP_ALLOWLIST=192.168.4.0/24

# Session policy
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_HOURS=8
IDLE_LOCK_MIN=30
