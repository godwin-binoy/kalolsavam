# === Cloudflare Tunnel (optional) ===
# Enable by running: docker compose --profile tunnel up -d --build
CLOUDFLARE_TUNNEL_TOKEN=

# === Backend ===
# PUBLIC_ORIGIN is the FRONTEND origin (where the browser loads the page
# from) — NOT the tunnel API hostname. It is used for the CORS allowlist
# and the security middleware's Origin/Referer check.
#
# Split deploy (static frontend on Cloudflare Pages + API via tunnel):
#   PUBLIC_ORIGIN = the Pages URL (custom domain or *.pages.dev)
#   public/config.js = the tunnel API hostname
#
# Single-origin Docker self-host:
#   PUBLIC_ORIGIN = http://localhost:8000
# Must start with http:// or https://.
PUBLIC_ORIGIN=https://mala-subdistrict-kalolsavam.pages.dev
# Extra allowed origins (comma-separated), used only for cross-origin setups
ALLOWED_ORIGINS=
# Leave blank to auto-generate and persist in ./deployment/secret.key
SECRET_KEY=
SESSION_TTL_MIN=480
TRUST_PROXY_HEADERS=true
RESULTS_URL=https://kalolsavam.kerala.gov.in/

# === Initial admin (only used on first run) ===
# Leave password blank to have a random temp password printed to `docker compose logs backend`.
ADMIN_EMAIL=admin@kalolsavam.example.com
ADMIN_PASSWORD=
