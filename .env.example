# ============================================================================
# Kalolsavam — Option B (1 Core Server + 2 Outbound-Only Workers)
#   1 device:  docker compose --profile tunnel --profile photos --profile obs up -d
#   2/3 devs:  Device 1 runs backend+tunnel; Device 2 runs --profile photos;
#              Device 3 runs --profile obs (set CORE_URL to public API URL).
# ============================================================================

# === Cloudflare Tunnel (Device 1) ===
CLOUDFLARE_TUNNEL_TOKEN=

# === Core / Workers Shared Config ===
# Leave CORE_URL empty on 1-device setups (defaults to http://backend:8000).
# On separate Device 2 / Device 3 machines, set CORE_URL=https://apikalolsavammala.dpdns.org
CORE_URL=
# Must be identical (>=32 chars) across Device 1, Device 2, and Device 3.
SECRET_KEY=
ARCHIVE_ORIGINALS=false

# === Backend ===
PUBLIC_ORIGIN=https://mala-subdistrict-kalolsavam.pages.dev
ALLOWED_ORIGINS=
SESSION_TTL_MIN=480
TRUST_PROXY_HEADERS=true
RESULTS_URL=https://kalolsavam.kerala.gov.in/

# === Initial admin (only used on first boot) ===
ADMIN_EMAIL=admin@kalolsavam.example.com
ADMIN_PASSWORD=
