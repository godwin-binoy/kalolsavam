# ===== server runtime configuration (template) =====
# The backend reads server/.env — copy this file there and fill in the seed.
# Real values go ONLY in the untracked server/.env, never here.
#
# Everything has a working default; the ONE thing you must set is
# SESSION_SIGNING_SEEDS:
#   python -c "import secrets; print('k1:'+secrets.token_hex(32))"

# HMAC key(s) for signing access tokens ("kid:hex64", comma-separated).
# One pair is enough; rotation = put a new kid first (old tokens die in 15 min).
SESSION_SIGNING_SEEDS=

# Bind — loopback only. The Cloudflare tunnel (cloudflared) runs on this same
# box and connects to us over 127.0.0.1; there is no LAN access any more.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Must stay 1 behind the tunnel: real visitor IPs come from CF-Connecting-IP.
# Production refuses to boot with TRUST_PROXY=0.
TRUST_PROXY=1

# TLS is terminated at Cloudflare's edge — no local certs needed.
# Set FORCE_TLS=1 (+ paths below) ONLY if you front us with your own HTTPS
# reverse proxy instead of the tunnel.
FORCE_TLS=0
#TLS_CERT_PATH=
#TLS_KEY_PATH=

# Session policy
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_HOURS=8
IDLE_LOCK_MIN=30

# Production mode: "production" enables the startup safety checks (loopback
# bind without FORCE_TLS, TRUST_PROXY=1). Leave unset/"development" locally.
#ENVIRONMENT=production

# Official results live on the government site — we only redirect there.
RESULTS_REDIRECT_URL=https://kalolsavam.kerala.gov.in/

# Optional cosmetic URL suffix for the staff dashboards (/admin-2k26 etc.).
# Convenience only — NEVER a security boundary.
DASHBOARD_SUFFIX=
