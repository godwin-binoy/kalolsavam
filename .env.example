# ============================================================================
# Kalolsavam — split deploy
#   Static frontend  -> Cloudflare Pages
#   Backend + tunnel -> this host (docker compose)
# ============================================================================

# === Cloudflare Tunnel (required for split deploy) ===
# Token from Zero Trust > Networks > Tunnels > <your tunnel>
# > Configure > Install Connector > Docker tab.
# Starts with 'eyJ...', typically 150-200 chars.
#   ./kal token set '<token>'      validates and stores it
CLOUDFLARE_TUNNEL_TOKEN=

# === Backend ===
# PUBLIC_ORIGIN is the FRONTEND origin the browser loads pages from —
# i.e. your Cloudflare Pages URL or custom domain. NOT the tunnel hostname.
# It feeds the CORS allowlist and the Origin/Referer check on every POST.
#
# Must start with http:// or https://. Empty -> backend refuses to start.
PUBLIC_ORIGIN=https://mala-subdistrict-kalolsavam.pages.dev

# Extra allowed browser origins, comma-separated. Add a custom domain here
# if you also serve the frontend from it. Pages preview URLs
# (<hash>.your-site.pages.dev) are already allowed by the regex in
# server/app.py, so you don't need to enumerate them.
ALLOWED_ORIGINS=

# Leave blank to auto-generate and persist in ./deployment/secret.key
SECRET_KEY=
SESSION_TTL_MIN=480
TRUST_PROXY_HEADERS=true
RESULTS_URL=https://kalolsavam.kerala.gov.in/

# === Initial admin (only used on first boot) ===
# Leave password blank to have a random temp password printed to
# `docker compose logs backend` ONCE on first boot.
# If you set it here, it is never printed again (patch already applied).
ADMIN_EMAIL=admin@kalolsavam.example.com
ADMIN_PASSWORD=
