# === Cloudflare Tunnel (optional) ===
# Enable by running: docker compose --profile tunnel up -d --build
CLOUDFLARE_TUNNEL_TOKEN=

# === Backend ===
# Origin the browser will hit (must start with http:// or https://)
PUBLIC_ORIGIN=https://kalolsavam.example.com
# Extra allowed origins (comma-separated), used only for cross-origin setups
ALLOWED_ORIGINS=
# Leave blank to auto-generate and persist in ./deployment/secret.key
SECRET_KEY=
SESSION_TTL_MIN=480
TRUST_PROXY_HEADERS=true
RESULTS_URL=https://kalolsavam.kerala.gov.in/

# === Initial admin (only used on first run) ===
# Leave password blank to have a random temp password printed to `docker compose logs backend`.
ADMIN_EMAIL=admin@kalolsavam.example.com
ADMIN_PASSWORD=
