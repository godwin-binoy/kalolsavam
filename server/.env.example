# ===== server runtime (NEVER commit the real .env) =====
# Copy to .env and fill in. Everything has a sane default except the seed.
# Generate the signing secret with:
#   python -c "import secrets; print('k1:'+secrets.token_hex(32))"

# HMAC key(s) for signing access tokens ("kid:hex64", comma-separated).
# One pair is enough; rotation = put a new kid first, old tokens expire in 15 min.
SESSION_SIGNING_SEEDS=

# Bind address. Keep 127.0.0.1 — cloudflared connects to us locally and
# everyone reaches the site from the internet through the Cloudflare tunnel.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Read the real visitor IP from CF-Connecting-IP. Must stay 1 whenever a
# tunnel/proxy fronts the server (rate limits depend on it).
TRUST_PROXY=1

# Optional: URL suffix for the staff dashboards (/admin<suffix>, /stagemaster<suffix>).
# Cosmetic only — protection comes from the APIs, not the URL. Leave empty for /admin.
DASHBOARD_SUFFIX=

# Session policy
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_HOURS=8
IDLE_LOCK_MIN=30

# Official results live on the government website; our links redirect there.
RESULTS_REDIRECT_URL=https://kalolsavam.kerala.gov.in/

# Only needed if you deliberately run your own HTTPS reverse proxy instead of
# the Cloudflare tunnel (then also set SERVER_HOST accordingly). Leave unset otherwise.
#FORCE_TLS=1
#TLS_CERT_PATH=...
#TLS_KEY_PATH=...
