# Copy to server/.env and edit.
#
# PUBLIC_ORIGIN must be the ORIGIN OF THE FRONTEND (your Cloudflare Pages
# URL) that issues browser requests to https://malakalolsavamapi.qd.je.
PUBLIC_ORIGIN=https://your-site.pages.dev
# Optional comma-separated extra origins allowed to call the API:
ALLOWED_ORIGINS=
SESSION_TTL_MIN=480
SECRET_KEY=
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DB_PATH=deployment/kalolsavam.db
AUTH_DB_PATH=deployment/fullauth.db
RESULTS_URL=https://kalolsavam.kerala.gov.in/
# Set to true when running behind Cloudflare Tunnel so client IPs are resolved:
TRUST_PROXY_HEADERS=true
