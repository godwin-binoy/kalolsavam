---
import '../styles/global.css';
import { BASE, url } from '../lib/url';
const { title = "Mala Sub-District Kalolsavam", active = "" } = Astro.props;
const nav = [
  ["home", "/", "Home"],
  ["venues", "/venues", "Stages"],
  ["media", "/media", "Photos"],
  ["facilities", "/facilities", "Facilities"],
  ["transportation", "/transportation", "Transport"],
  ["developers", "/developers", "Team"],
  ["help", "/help", "Help / Emergency"],
];
const navKey = (k: string) => `nav.${k}`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#FCFBF9">
<link rel="manifest" href={BASE + 'manifest.json'}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Malayalam:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Malayalam:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Kalolsavam">
<link rel="apple-touch-icon" href={BASE + 'assets/img/logo.webp'}>
<title>{title}</title>
<meta name="description" content="Official web desk for the Mala Sub-District School Kalolsavam at St. Antony's HSS Mala.">
<link rel="icon" type="image/webp" href={BASE + 'assets/img/logo.webp'}>
<script is:inline src={BASE + 'assets/js/theme.js'}></script>
<script is:inline src={BASE + 'assets/js/lang.js?v=4.1.7'}></script>
</head>
<body data-nav={active} data-base={BASE}>
<a class="skip" href="#main">Skip to content</a>
<header class="hdr">
  <div class="hdr-in">
    <a class="brand" href={BASE}>
      <img src={BASE + 'assets/img/logo.webp'} alt="St. Antony's HSS Mala" class="logo-box" width="40" height="40" decoding="async">
      <span class="brand-name"><span data-i18n="brand.name">St. Antony's HSS Mala</span><small data-i18n="brand.sub">Sub-District School Kalolsavam</small></span>
    </a>
    <nav class="nav" aria-label="Primary">
      {nav.map(([key, href, label]) => (
        <a href={url(href)} class:list={["nav-link", { active: active === key }, key === "help" && "nav-link-help"]} data-active={key} data-i18n={navKey(key)}>{label}</a>
      ))}
      <button data-lang-toggle class="lang-btn" type="button" aria-label="Switch language" title="Switch language"><span class="icn" style={`--icon-url:url('${BASE}assets/svg/translate.svg')`}></span></button>
      <button id="theme" class="icbtn" style="margin-left:0.5rem" type="button" aria-label="Toggle dark mode">
        <span class="icn icn-moon" style={`--icon-url:url('${BASE}assets/svg/moon.svg')`}></span>
        <span class="icn icn-sun" style={`--icon-url:url('${BASE}assets/svg/sun.svg')`}></span>
      </button>
    </nav>
    <div class="mobile-controls">
      <button data-lang-toggle class="lang-btn" type="button" aria-label="Switch language" title="Switch language"><span class="icn" style={`--icon-url:url('${BASE}assets/svg/translate.svg')`}></span></button>
      <a href={url('/help')} class="help-btn-m" aria-label="Help & Emergency">
        <span class="icn" style={`--icon-url:url('${BASE}assets/svg/phone.svg')`}></span>
        <span class="help-text" data-i18n="nav.help_fast">Help</span>
      </a>
      <button id="theme-m" class="icbtn" type="button" aria-label="Toggle dark mode">
        <span class="icn icn-moon" style={`--icon-url:url('${BASE}assets/svg/moon.svg')`}></span>
        <span class="icn icn-sun" style={`--icon-url:url('${BASE}assets/svg/sun.svg')`}></span>
      </button>
      <button id="menu" class="icbtn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mnav">
        <span class="icn menu-open" style={`--icon-url:url('${BASE}assets/svg/menu.svg')`}></span>
        <span class="icn menu-close" style={`--icon-url:url('${BASE}assets/svg/close.svg')`}></span>
      </button>
    </div>
  </div>
  <nav id="mnav" class="mnav" aria-label="Mobile">
    {nav.map(([key, href, label]) => (
      <a href={url(href)} class:list={[{ active: active === key }, key === "help" && "nav-link-help"]} data-active={key} data-i18n={navKey(key)}>{label}</a>
    ))}
  </nav>
</header>
<main id="main"><slot /></main>
<footer class="ftr">
  <div class="ftr-in">
    <div>
      <strong data-i18n="footer.title">Mala Sub-District School Kalolsavam</strong>
      <span data-i18n="footer.address">St. Antony's Higher Secondary School, Mala, Thrissur, Kerala 680732</span>
    </div>
    <div class="ftr-meta">v4.0.0 · <a href={url('/developers')} style="color:var(--footer-fg);text-decoration:underline" data-i18n="footer.dev">Meet the Developers</a></div>
  </div>
</footer>
<script is:inline src={BASE + 'assets/js/app.js?v=4.1.7'}></script>
</body>
</html>
