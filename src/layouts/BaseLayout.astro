---
import '../styles/global.css';
import { API_BASE, BASE, url } from '../lib/url';
import pkg from '../../package.json';
const { title = "Mala Sub-District Kalolsavam", active = "" } = Astro.props;
const VERSION = pkg.version;
const siteOrigin = Astro.site || 'https://mala-subdistrict-kalolsavam.pages.dev';
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const ogImage = new URL(BASE + 'assets/img/logo.webp', siteOrigin).href;
const nav = [
  ["home", "/", "Home"],
  ["venues", "/venues", "Stages"],
  ["facilities", "/facilities", "Facilities"],
  ["media", "/media", "Photos"],
  ["transportation", "/transportation", "Transport"],
  ["help", "/help", "Help / Emergency"],
  ["developers", "/developers", "Team"],
];
const navKey = (k: string) => `nav.${k}`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#FCFBF9">
<meta name="google-site-verification" content="vzMso-0ejUvNluhtRJGoxRLlRYMbxoQGiq6yO8gtX5A">
<link rel="manifest" href={BASE + 'manifest.json'}>
<link rel="canonical" href={canonicalUrl}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Malayalam:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Kalolsavam">
<link rel="apple-touch-icon" href={BASE + 'assets/img/logo.webp'}>
<title>{title}</title>
<meta name="description" content="Official web desk for the Mala Sub-District School Kalolsavam at St. Antony's HSS Mala.">
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content="Live stages, venue finder, facilities, transport, and official updates for the Mala Sub-District School Kalolsavam.">
<meta property="og:url" content={canonicalUrl}>
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content="summary">
<link rel="icon" type="image/webp" href={BASE + 'assets/img/logo.webp'}>
<script is:inline>try{if(localStorage.getItem('kal_theme')==='dark')document.documentElement.classList.add('dark')}catch(e){}</script>
<script is:inline src={BASE + 'assets/js/lang.js?v=' + VERSION}></script>
</head>
<body data-nav={active} data-base={BASE} data-api={API_BASE}>
<script is:inline src={BASE + 'config.js'}></script>
<script is:inline src={BASE + 'assets/js/common.js?v=' + VERSION}></script>
<script is:inline src={BASE + 'data/search-index.js?v=' + VERSION}></script>
<script is:inline src={BASE + 'assets/js/search.js?v=' + VERSION}></script>
<a class="skip" href="#main">Skip to content</a>

<header class="hdr" id="main-header">
  <div class="hdr-in">
    <a class="brand" href={BASE}>
      <img src={BASE + 'assets/img/logo.webp'} alt="St. Antony's HSS Mala" class="logo-box" width="40" height="40" decoding="async">
      <span class="brand-name"><span data-i18n="brand.name">St. Antony's HSS Mala</span><small data-i18n="brand.sub">Sub-District School Kalolsavam</small></span>
    </a>
    <nav class="nav" aria-label="Primary">
      {nav.map(([key, href, label]) => (
        <a href={url(href)} class:list={["nav-link", { active: active === key }, key === "help" && "nav-link-help"]} data-active={key} data-i18n={navKey(key)}>{label}</a>
      ))}
    </nav>

    <div class="mobile-controls">
      <a href={url('/help')} class="help-btn-m" aria-label="Help & Emergency">
        <span class="icn" style={`--icon-url:url('${BASE}assets/svg/phone.svg')`}></span>
        <span class="help-text" data-i18n="nav.help_fast">Help</span>
      </a>
      <button id="menu" class="icbtn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mnav">
        <span class="icn menu-open" style={`--icon-url:url('${BASE}assets/svg/menu.svg')`}></span>
        <span class="icn menu-close" style={`--icon-url:url('${BASE}assets/svg/close.svg')`}></span>
      </button>
    </div>
  </div>
  <nav id="mnav" class="mnav" aria-label="Mobile">
    {nav.map(([key, href, label]) => (
      <a href={url(href)} class:list={[{ active: active === key }, key === "help" && "nav-link-help"]} data-active={key} data-i18n={navKey(key)}>{label}</a>
    ))}
  </nav>
</header>
  <div class="utility-dock " role="group" aria-label="Display settings">
      <button id="open-search" data-open-search class="icbtn" type="button" aria-label="Search anything (Ctrl+K)" title="Search anything (Ctrl+K)">
        <span class="icn" style={`--icon-url:url('${BASE}assets/svg/search.svg')`}></span>
      </button>
      <button data-lang-toggle class="lang-btn" type="button" aria-label="Switch language" title="Switch language">
        <span class="icn" style={`--icon-url:url('${BASE}assets/svg/translate.svg')`}></span>
      </button>
      <button id="theme" class="icbtn" type="button" aria-label="Toggle dark mode">
        <span class="icn icn-moon" style={`--icon-url:url('${BASE}assets/svg/moon.svg')`}></span>
        <span class="icn icn-sun" style={`--icon-url:url('${BASE}assets/svg/sun.svg')`}></span>
      </button>
    </div>
  <div class="dev-banner" role="status" aria-live="polite"><span class="dev-banner-dot" aria-hidden="true"></span><span data-i18n="banner.dev">This website is under active development — schedules and features are being updated.</span></div>
<div class="disclaimer-banner" role="note"><span data-i18n="banner.disclaimer">Note: Information here may contain mistakes — please verify via traditional means (printed notices / announcements) and report any errors spotted.</span></div>
<div class="disclaimer-banner" role="note"><span data-i18n="banner.disclaimer">Note: Information here may contain mistakes — please verify via traditional means (printed notices / announcements) and report any errors spotted.</span></div>
<main id="main"><slot /></main>
<footer class="ftr">
  <div class="ftr-in">
    <div>
      <strong data-i18n="footer.title">Mala Sub-District School Kalolsavam</strong>
      <span data-i18n="footer.address">St. Antony's Higher Secondary School, Mala, Thrissur, Kerala 680732</span>
    </div>
    <div class="ftr-meta">v{VERSION} · <a href={url('/developers')} style="color:var(--footer-fg);text-decoration:underline" data-i18n="footer.dev">Meet the Developers</a></div>
  </div>
</footer>

<div id="kal-search-modal" class="search-modal hidden" role="dialog" aria-modal="true" aria-labelledby="kal-modal-title" aria-hidden="true">
  <div class="search-modal-backdrop"></div>
  <div class="search-modal-box">
    <div class="search-modal-head">
      <span class="icn" style={`--icon-url:url('${BASE}assets/svg/search.svg');width:1.2rem;height:1.2rem;color:var(--brand)`}></span>
      <input id="kal-modal-input" type="search" placeholder="Search events, stages, rooms, buses, facilities, contacts…" autocomplete="off" spellcheck="false" aria-label="Site-wide search">
      <button id="kal-modal-close" type="button" class="icbtn" aria-label="Close search">&times;</button>
    </div>
    <div class="search-modal-chips" role="tablist" aria-label="Filter search results">
      <button type="button" class="search-chip active" data-search-group="all">All</button>
      <button type="button" class="search-chip" data-search-group="events">Events</button>
      <button type="button" class="search-chip" data-search-group="venues">Venues</button>
      <button type="button" class="search-chip" data-search-group="facilities">Facilities</button>
      <button type="button" class="search-chip" data-search-group="transport">Transport</button>
      <button type="button" class="search-chip" data-search-group="help">Help</button>
    </div>
    <div id="kal-modal-list" class="search-modal-list"></div>
    <div class="search-modal-foot">
      <span>Tip: Press <kbd>Ctrl</kbd>+<kbd>K</kbd> or <kbd>/</kbd> anywhere · <kbd>&uarr;</kbd><kbd>&darr;</kbd> to navigate · <kbd>Enter</kbd> to open</span>
    </div>
  </div>
</div>
</body>
</html>
