---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { TEAM_MEMBERS, VOLUNTEERS } from '../data/festival';
---
<BaseLayout title="Meet the Team | Mala Kalolsavam" active="developers">
  <div class="main-container">
    <PageHead badge="Project Team" title="Meet the Team & Backstage Crew" intro="The dedicated individuals working behind the scenes to build, maintain, and run the digital platform." />

    <div id="developers" class="sec-head" style="margin-top:2rem">
      <h2 class="section-title" data-i18n="dev.sec1">Core Developers & Creators</h2>
      <p data-i18n="dev.sec1.desc">Architecture, design, database administration, and branding.</p>
    </div>
    <div class="grid-3">
      {TEAM_MEMBERS.map((m) => (
        <div class="card-base">
          <span class="badge-gov" style="margin-bottom:.5rem">{m.role}</span>
          <h3 class="card-title">{m.name}</h3>
          <p class="text-muted sm">{m.desc}</p>
        </div>
      ))}
    </div>

    <div id="volunteers" class="sec-head" style="margin-top:4rem">
      <h2 class="section-title" data-i18n="dev.sec2">Festival Maintenance & Operations Volunteers</h2>
      <p data-i18n="dev.sec2.desc">The backbone of our operations across photography, stage control, server rooms, and desk management.</p>
    </div>
    <div class="grid-3">
      {VOLUNTEERS.map((v) => (
        <div class="card-base">
          <span class="badge-live" style="margin-bottom:.5rem">Volunteer Unit</span>
          <h3 class="card-title">{v.group}</h3>
          <p class="text-muted sm">{v.desc}</p>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
