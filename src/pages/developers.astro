---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BASE, url } from '../lib/url';
import PageHead from '../components/PageHead.astro';
---
<BaseLayout title="Meet the Team | Mala Kalolsavam" active="developers">
  <div class="main-container">
    <PageHead badge="Project Team" title="Meet the Team &amp; Backstage Crew" data-i18n="dev.title" data-i18n="dev.title" intro="The dedicated individuals working behind the scenes to build, maintain, and run the digital platform." data-i18n="dev.desc" data-i18n="dev.desc" />
    
    <div id="developers" class="sec-head" style="margin-top:2rem">
      <h2 class="section-title" data-i18n="dev.sec1">Core Developers &amp; Creators</h2>
      <p data-i18n="dev.sec1.desc">Architecture, design, database administration, and branding.</p>
    </div>
    <div class="grid-3">
      <div class="card-base">
        <span class="badge-gov" style="margin-bottom:.5rem">Lead Architect</span>
        <h3 class="card-title">Name 1</h3>
        <p class="text-muted sm">Full-stack Frontend, Backend FastAPI API, Infrastructure &amp; CI/CD Pipeline.</p>
      </div>
      <div class="card-base">
        <span class="badge-gov" style="margin-bottom:.5rem">UI/UX Designer</span>
        <h3 class="card-title">Name 2</h3>
        <p class="text-muted sm">Design System, Glassmorphism Animations, Micro-interactions &amp; Accessibility.</p>
      </div>
      <div class="card-base">
        <span class="badge-gov" style="margin-bottom:.5rem">Systems Admin</span>
        <h3 class="card-title">Name 3</h3>
        <p class="text-muted sm">Deployment, Reverse Proxy, SQLite WAL Database &amp; Automated Backups.</p>
      </div>
      <div class="card-base">
        <span class="badge-gov" style="margin-bottom:.5rem">Data HR</span>
        <h3 class="card-title">Name 4</h3>
        <p class="text-muted sm">Participant Data Management, Schedule Synchronization &amp; Validation.</p>
      </div>
      <div class="card-base">
        <span class="badge-gov" style="margin-bottom:.5rem">Logo Designer 1</span>
        <h3 class="card-title">Name 5</h3>
        <p class="text-muted sm">Master Logo Branding, Vector Assets &amp; Festival Visual Identity.</p>
      </div>
      <div class="card-base">
        <span class="badge-gov" style="margin-bottom:.5rem">Logo Designer 2</span>
        <h3 class="card-title">Name 6</h3>
        <p class="text-muted sm">PWA Iconography, Watermark Graphics &amp; Promotional Banners.</p>
      </div>
    </div>

    <div id="volunteers" class="sec-head" style="margin-top:4rem">
      <h2 class="section-title" data-i18n="dev.sec2">Festival Maintenance &amp; Operations Volunteers</h2>
      <p data-i18n="dev.sec2.desc">The backbone of our operations across photography, stage control, server rooms, and desk management.</p>
    </div>
    
    <div class="grid-3">
      <div class="card-base">
        <span class="badge-live" style="margin-bottom:.5rem">Organizers</span>
        <h3 class="card-title">Coordination Team</h3>
        <p class="text-muted sm">Overall festival coordination, stage timing oversight, and committee liaison.</p>
      </div>
      <div class="card-base">
        <span class="badge-live" style="margin-bottom:.5rem">Photographers</span>
        <h3 class="card-title">Media &amp; Stage Captures</h3>
        <p class="text-muted sm">High-resolution stage performance photography and candid gallery management.</p>
      </div>
      <div class="card-base">
        <span class="badge-live" style="margin-bottom:.5rem">Videographers</span>
        <h3 class="card-title">Streaming &amp; Recording</h3>
        <p class="text-muted sm">Live streaming telecasts, stage video capture, and archive maintenance.</p>
      </div>
      <div class="card-base">
        <span class="badge-live" style="margin-bottom:.5rem">Editors</span>
        <h3 class="card-title">Post-Production Desk</h3>
        <p class="text-muted sm">Instant highlight reels, media sorting, and daily photo/video publishing.</p>
      </div>
      <div class="card-base">
        <span class="badge-live" style="margin-bottom:.5rem">Desk Incharges</span>
        <h3 class="card-title">Help &amp; Stage Control</h3>
        <p class="text-muted sm">Chest number reporting, convener assistance, and stage queue management.</p>
      </div>
      <div class="card-base">
        <span class="badge-live" style="margin-bottom:.5rem">Server Room Incharges</span>
        <h3 class="card-title">Backend &amp; Database Ops</h3>
        <p class="text-muted sm">Real-time SSE monitoring, server uptime, and database backups.</p>
      </div>
    </div>

  </div>
</BaseLayout>
