---
import BaseLayout from '../../layouts/BaseLayout.astro';
import stages from '../../data/stages.json';

export function getStaticPaths() {
  const STAGE_IDS = new Set([1, 2, 3, 4, 5, 6, 7, 8, 9, 26]);
  const stageItems = stages.filter(s => s.kind === 'stage' || STAGE_IDS.has(Number(s.n)));
  return stageItems.map((s) => ({ params: { n: String(s.n) }, props: { stage: s } }));
}
const { stage } = Astro.props;
---
<BaseLayout title={`Stage ${stage.n} · ${stage.name} | Mala Kalolsavam`} active="venues">
  <div class="main-container"></div>
</BaseLayout>
