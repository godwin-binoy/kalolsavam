---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Card from '../components/Card.astro';
import ActionItem from '../components/ActionItem.astro';
---
<BaseLayout title="Results | Mala Kalolsavam" active="">
  <div class="main-container">
    <PageHead badge="Results · Official" title="Results" intro="Off-stage, individual, and group item results — linked to the official government portal." />
    <div class="grid-3">
      <Card href="/results-offstage" title="Off Stage" titleI18n="res.offstage.title" subtitle="Drawing · Writing · Crafts" subtitleI18n="res.offstage.sub" tone="orange">
        <p class="text-muted sm" data-i18n="res.offstage.desc">Chithra drawing, pencil drawing, collage, cartoon, and clay modeling results.</p>
        <ActionItem href="/results-offstage" title="View Off Stage Results" titleI18n="res.offstage.btn" />
      </Card>
      <Card href="/results-individual" title="Individual Stage" titleI18n="res.indiv.title" subtitle="Dance · Music · Elocution" subtitleI18n="res.indiv.sub" tone="orange">
        <p class="text-muted sm" data-i18n="res.indiv.desc">Bharathanatyam, Mohiniyattam, light music, classical music, and elocution.</p>
        <ActionItem href="/results-individual" title="View Individual Results" titleI18n="res.indiv.btn" />
      </Card>
      <Card href="/results-group" title="Group Stage" titleI18n="res.group.title" subtitle="Oppana · Margamkali · Drama" subtitleI18n="res.group.sub" tone="orange">
        <p class="text-muted sm" data-i18n="res.group.desc">Oppana, margamkali, nadan pattu, group dance, and drama results.</p>
        <ActionItem href="/results-group" title="View Group Results" titleI18n="res.group.btn" />
      </Card>
    </div>
  </div>
</BaseLayout>
