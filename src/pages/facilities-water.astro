---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Card from '../components/Card.astro';
import { WATER_STATIONS } from '../data/festival';
---
<BaseLayout title="Drinking Water | Mala Kalolsavam" active="facilities">
  <div class="main-container">
    <PageHead badge="Drinking Water" title="Drinking Water Stations" intro="Filtered RO drinking water points available across the campus for participants, parents, and staff." />
    <div class="grid-2">
      {WATER_STATIONS.map((w) => (
        <Card title={w.name} subtitle={w.sub} tone="teal" icon="sparkle">
          <p class="text-muted sm">{w.desc}</p>
          <div class="fest-action-item">
            <span><strong>Location:</strong> {w.loc}</span>
          </div>
        </Card>
      ))}
    </div>
  </div>
</BaseLayout>
