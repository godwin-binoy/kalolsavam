---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BASE, url } from '../lib/url';
import PageHead from '../components/PageHead.astro';
import stages from '../data/stages.json';
---
<BaseLayout title="Live Stage Updates | Mala Kalolsavam" active="venues">
  <div class="main-container">
    <PageHead badge="Module 01 · Live Tracker" title="All Stages — Live" intro="Real-time status across all 9 stages. Tap any stage for its full detail page." />
    <div id="live" class="grid-3" data-refresh-ms="5000">
      {stages.map((s) => (
        <a href={url(`venues-stage/${s.n}`)} class="fest-card stage-live-card" data-stage-name={s.name} data-stage-slug={s.slug} data-stage-n={s.n} style="text-decoration:none;color:inherit">
          <div class={`fest-header ${s.banner}`} style="padding:1rem 1.25rem">
            <div style="display:flex;justify-content:space-between;align-items:center;gap:.5rem;flex-wrap:wrap">
              <h3 class="fest-title" style="font-size:1.05rem;margin:0">Stage {s.n}</h3>
              <span class="badge-live stage-state" data-state="IDLE"><span class="live-dot"></span><span class="stage-state-label">IDLE</span></span>
            </div>
            <span class="fest-subtitle" style="margin-top:.35rem">{s.name}</span>
          </div>
          <div class="fest-body" style="padding:1rem 1.25rem;gap:.5rem">
            <div class="stage-now text-muted sm"><span class="stage-now-label">On stage:</span> <span class="stage-now-item">—</span></div>
            <div class="stage-upcoming text-muted xs" style="line-height:1.5"><span class="stage-upcoming-label">Up next:</span> <span class="stage-upcoming-items">—</span></div>
            <div style="margin-top:.4rem;display:flex;align-items:center;justify-content:space-between">
              <small class="text-muted" style="font-size:.72rem">{s.short}</small>
              <span class="fest-arrow" style={`--icon-url:url('${BASE}assets/svg/arrow-right.svg');width:1rem;height:1rem`}></span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
  <script is:inline src={BASE + 'assets/js/live.js'}></script>
</BaseLayout>
