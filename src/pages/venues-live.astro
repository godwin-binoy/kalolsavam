---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BASE, url } from '../lib/url';
import PageHead from '../components/PageHead.astro';
import stages from '../data/stages.json';

const STAGE_IDS = new Set([1, 2, 3, 4, 5, 6, 7, 8, 9, 26]);
const liveStages = stages
  .filter((s) => s.kind === 'stage' || STAGE_IDS.has(Number(s.n)))
  .sort((a, b) => Number(a.n) - Number(b.n));
---
<BaseLayout title="Live Stage Updates | Mala Kalolsavam" active="venues">
  <div class="main-container">
    <PageHead badge="Live Tracker" title="Live Stages" intro="Real-time on-stage tracker for Stages 1 to 9 and Stage 26. Tap any stage for full details and schedule." />
    <div id="live" class="grid-3" data-refresh-ms="10000">
      {liveStages.map((s) => {
        const cleanName = s.name.replace(/^Venue \d+\s*-\s*/, '');
        return (
          <a href={url(`venues-stage/${s.n}`)} class="fest-card stage-live-card" data-stage-name={s.name} data-stage-slug={s.slug} data-stage-n={s.n} style="text-decoration:none;color:inherit">
            <div class={`fest-header ${s.banner}`} style="padding:1rem 1.25rem">
              <div style="display:flex;justify-content:space-between;align-items:center;gap:.5rem;flex-wrap:wrap">
                <h3 class="fest-title" style="font-size:1.05rem;margin:0">Stage {s.n}</h3>
                <span class="badge-live stage-state" data-state="IDLE"><span class="live-dot"></span><span class="stage-state-label">IDLE</span></span>
              </div>
              <span class="fest-subtitle" style="margin-top:.35rem">{cleanName}</span>
            </div>
            <div class="fest-body" style="padding:1rem 1.25rem;gap:.5rem">
              <div class="stage-now text-muted sm"><span class="stage-now-label">On stage:</span> <span class="stage-now-item">—</span></div>
              <div class="stage-upcoming text-muted xs" style="line-height:1.5"><span class="stage-upcoming-label">Up next:</span> <span class="stage-upcoming-items">—</span></div>
              <div style="margin-top:.4rem;display:flex;align-items:center;justify-content:space-between">
                <small class="text-muted" style="font-size:.72rem">{s.loc}</small>
                <span class="fest-arrow" style={`--icon-url:url('${BASE}assets/svg/arrow-right.svg');width:1rem;height:1rem`}></span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
  <script is:inline>
    (function(){
      var K = window.Kal, root = K && K.el('live');
      if (!root) return;
      var _raw = parseInt(root.getAttribute('data-refresh-ms') || '10000', 10);
      var refreshMs = Math.max(5000, Number.isFinite(_raw) ? _raw : 10000);
      var cards = Array.from(root.querySelectorAll('.stage-live-card')).map(function(el){
        return {
          el: el,
          n: el.getAttribute('data-stage-n') || '',
          slug: el.getAttribute('data-stage-slug') || '',
          name: el.getAttribute('data-stage-name') || ''
        };
      });
      function setState(el, state){
        el.setAttribute('data-state', state);
        var lbl = el.querySelector('.stage-state-label'); if (lbl) lbl.textContent = state;
        el.classList.toggle('is-live', state === 'RUNNING' || state === 'ON-STAGE');
      }
      function render(d){
        var venues = (d && d.venues) || [];
        cards.forEach(function(item){
          var card = item.el;
          var v = venues.find(function(x){
            return (x.id && String(x.id) === String(item.n)) || K.matchStage(x, item.slug, item.name);
          });
          var st = card.querySelector('.stage-state'), ne = card.querySelector('.stage-now-item'),
              ue = card.querySelector('.stage-upcoming-items'), nl = card.querySelector('.stage-now-label'), ul = card.querySelector('.stage-upcoming-label');
          if (!v){ if (st) setState(st, 'IDLE'); nl.textContent = 'Live data:'; ne.innerHTML = '<span class="text-muted">not configured</span>'; ul.textContent = ''; ue.textContent = ''; return; }
          if (st) setState(st, v.state || 'IDLE');
          if (v.active === false || v.state === 'INACTIVE'){ nl.textContent = 'Status:'; ne.innerHTML = '<span class="text-muted">Stage inactive</span>'; ul.textContent = ''; ue.textContent = ''; return; }
          nl.textContent = 'On stage:'; ul.textContent = 'Up next:';
          if (v.now){
            var parts = [];
            if (v.now.roll) parts.push('<strong>Chest #' + K.esc(v.now.roll) + '</strong>');
            if (v.now.event) parts.push(K.esc(v.now.event));
            ne.innerHTML = parts.length ? parts.join(' · ') : '<span class="text-muted">on stage</span>';
          } else ne.innerHTML = '<span class="text-muted">idle</span>';
          var ups = (v.upcoming || []).slice(0, 4);
          ue.innerHTML = ups.length ? ups.map(function(u){ return u.roll ? '<strong>#' + K.esc(u.roll) + '</strong>' : '—'; }).join(' &middot; ') : '—';
        });
      }
      K.poll(function(){
        K.fetchJSON('/api/v1/public/status').then(render).catch(function(){
          cards.forEach(function(it){
            it.el.querySelector('.stage-now-label').textContent = 'Live status:';
            it.el.querySelector('.stage-now-item').innerHTML = '<span class="text-muted">unavailable</span>';
            it.el.querySelector('.stage-upcoming-label').textContent = '';
            it.el.querySelector('.stage-upcoming-items').textContent = '';
          });
        });
      }, refreshMs);
    })();
  </script>
</BaseLayout>
