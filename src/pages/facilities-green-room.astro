---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Card from '../components/Card.astro';
import { GREEN_ROOMS } from '../data/festival';
---
<BaseLayout title="Green Rooms | Mala Kalolsavam" active="facilities">
  <div class="main-container">
    <PageHead badge="Module 04 · Green Room" title="Green Rooms" intro="Designated dressing and waiting rooms for participants, allotted by competition code. Rooms G1–G6 on the Annex Block first floor." />
    <div class="grid-3">
      {GREEN_ROOMS.map((g) => (
        <Card title={g.name} subtitle={g.sub} tone="teal">
          <p class="text-muted sm">{g.desc}</p>
          <div class="fest-action-item">
            <span><strong>Location:</strong> {g.loc}</span>
          </div>
        </Card>
      ))}
    </div>
  </div>
</BaseLayout>
