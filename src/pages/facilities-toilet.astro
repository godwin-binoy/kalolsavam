---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Card from '../components/Card.astro';
import { TOILET_BLOCKS } from '../data/festival';
---
<BaseLayout title="Toilets | Mala Kalolsavam" active="facilities">
  <div class="main-container">
    <PageHead badge="Module 04 · Toilet" title="Toilet Blocks" intro="Washrooms across the campus, with separate blocks for boys, girls, and staff." />
    <div class="grid-3">
      {TOILET_BLOCKS.map((t) => (
        <Card title={t.name} subtitle={t.sub} tone="blue">
          <p class="text-muted sm">{t.desc}</p>
          <div class="fest-action-item">
            <span><strong>Location:</strong> {t.loc}</span>
          </div>
        </Card>
      ))}
    </div>
  </div>
</BaseLayout>
