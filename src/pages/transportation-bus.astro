---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { MALA_TO_ANNAMANADA, ANNAMANADA_TO_MALA, MALA_LOCAL_CONNECTORS } from '../data/festival';
---
<BaseLayout title="Sub-District Bus Timings | Mala Kalolsavam" active="transportation">
  <div class="main-container">
    <PageHead badge="Mala Sub-District" title="Local Bus Timings" intro="Bus schedules strictly within the Mala Sub-District connecting festival venues, Annamanada, Eravathur, Vennur, Meladoor, Ashtamichira, Poyya, and Kuzhur." />

    <!-- Sub-District Route Tabs -->
    <div class="dir-toggle-wrapper">
      <button type="button" class="dir-btn active" data-dir="mla-anda">Mala → Annamanada ({MALA_TO_ANNAMANADA.length})</button>
      <button type="button" class="dir-btn" data-dir="anda-mla">Annamanada → Mala ({ANNAMANADA_TO_MALA.length})</button>
      <button type="button" class="dir-btn" data-dir="local-con">Poyya / Kuzhur ({MALA_LOCAL_CONNECTORS.length})</button>
    </div>

    <!-- Quick Stop Search -->
    <div class="card-base" style="margin-bottom:1.5rem;padding:1rem 1.25rem">
      <input id="bus-filter" type="search" class="inp" placeholder="Search by stop name or time (e.g. Meladoor, Eravathur, Vennur, Poyya, 08:10)..." autocomplete="off">
    </div>

    <!-- Tab 1: Mala to Annamanada / Eravathur / Vennur -->
    <div id="dir-mla-anda" class="bus-table-box card-base" style="padding:0;overflow:hidden">
      <div style="overflow-x:auto">
        <table class="tbl minimal-tbl">
          <thead>
            <tr>
              <th style="width:7rem">Time</th>
              <th>Destination (Within Sub-District)</th>
              <th>Via / Key Stops</th>
              <th style="width:6rem;text-align:right">Service</th>
            </tr>
          </thead>
          <tbody>
            {MALA_TO_ANNAMANADA.map((b) => (
              <tr data-search={`${b.time} ${b.route} ${b.via}`.toLowerCase()}>
                <td class="mono time-cell">{b.time}</td>
                <td class="route-cell"><strong>{b.route}</strong></td>
                <td class="text-muted sm">{b.via}</td>
                <td style="text-align:right"><span class="badge-gov sm-type">{b.type}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Tab 2: Annamanada / Eravathur to Mala -->
    <div id="dir-anda-mla" class="bus-table-box card-base" style="padding:0;overflow:hidden;display:none">
      <div style="overflow-x:auto">
        <table class="tbl minimal-tbl">
          <thead>
            <tr>
              <th style="width:7rem">Time</th>
              <th>Destination (To Mala Venues)</th>
              <th>Via / Key Stops</th>
              <th style="width:6rem;text-align:right">Service</th>
            </tr>
          </thead>
          <tbody>
            {ANNAMANADA_TO_MALA.map((b) => (
              <tr data-search={`${b.time} ${b.route} ${b.via}`.toLowerCase()}>
                <td class="mono time-cell">{b.time}</td>
                <td class="route-cell"><strong>{b.route}</strong></td>
                <td class="text-muted sm">{b.via}</td>
                <td style="text-align:right"><span class="badge-gov sm-type">{b.type}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Tab 3: Ashtamichira / Poyya / Kuzhur -->
    <div id="dir-local-con" class="bus-table-box card-base" style="padding:0;overflow:hidden;display:none">
      <div style="overflow-x:auto">
        <table class="tbl minimal-tbl">
          <thead>
            <tr>
              <th style="width:7rem">Time</th>
              <th>Sub-District Route</th>
              <th>Via / Key Stops</th>
              <th style="width:6rem;text-align:right">Service</th>
            </tr>
          </thead>
          <tbody>
            {MALA_LOCAL_CONNECTORS.map((b) => (
              <tr data-search={`${b.time} ${b.route} ${b.via}`.toLowerCase()}>
                <td class="mono time-cell">{b.time}</td>
                <td class="route-cell"><strong>{b.route}</strong></td>
                <td class="text-muted sm">{b.via}</td>
                <td style="text-align:right"><span class="badge-gov sm-type">{b.type}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <p id="no-bus-match" class="text-muted center" style="margin-top:2.5rem" hidden>No local sub-district routes match your search.</p>
  </div>

  <style>
    .dir-toggle-wrapper {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1.25rem;
      flex-wrap: wrap;
    }
    .dir-btn {
      flex: 1;
      min-width: 140px;
      padding: 0.75rem 1.25rem;
      border-radius: var(--radius-inner);
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text-heading);
      font-weight: 700;
      font-size: 0.92rem;
      cursor: pointer;
      transition: all 0.15s ease;
      text-align: center;
    }
    .dir-btn:hover {
      background: var(--bg-alt);
    }
    .dir-btn.active {
      background: var(--brand);
      color: var(--on-brand);
      border-color: var(--brand);
      box-shadow: 0 4px 12px rgba(27, 46, 32, 0.2);
    }
    .minimal-tbl th {
      padding: 0.85rem 1.25rem;
      background: var(--bg-alt);
    }
    .minimal-tbl td {
      padding: 0.85rem 1.25rem;
    }
    .time-cell {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--brand);
    }
    .route-cell {
      font-size: 0.95rem;
    }
    .sm-type {
      font-size: 0.72rem;
      padding: 0.2rem 0.55rem;
    }
  </style>

  <script is:inline>
    (function(){
      var toggleBtns = document.querySelectorAll('.dir-btn');
      var filterInp = document.getElementById('bus-filter');
      var emptyNotice = document.getElementById('no-bus-match');
      var activeDir = 'mla-anda';
      var tabs = ['mla-anda', 'anda-mla', 'local-con'];

      function updateActiveDir(dir){
        activeDir = dir;
        toggleBtns.forEach(function(b){
          b.classList.toggle('active', b.getAttribute('data-dir') === dir);
        });
        tabs.forEach(function(t){
          var el = document.getElementById('dir-' + t);
          if (el) el.style.display = (t === dir) ? '' : 'none';
        });
        filterTable();
      }

      function filterTable(){
        var q = (filterInp ? filterInp.value : '').trim().toLowerCase();
        var tokens = q.split(/\s+/).filter(Boolean);
        var activeBox = document.getElementById('dir-' + activeDir);
        if (!activeBox) return;
        var rows = Array.from(activeBox.querySelectorAll('tbody tr'));
        var visibleCount = 0;

        rows.forEach(function(r){
          var txt = r.getAttribute('data-search') || '';
          var matches = (!tokens.length) || tokens.every(function(t){ return txt.indexOf(t) >= 0; });
          if (matches){
            r.style.display = '';
            visibleCount++;
          } else {
            r.style.display = 'none';
          }
        });

        if (emptyNotice){
          emptyNotice.hidden = visibleCount > 0;
        }
      }

      toggleBtns.forEach(function(b){
        b.addEventListener('click', function(){
          updateActiveDir(b.getAttribute('data-dir'));
        });
      });

      if (filterInp){
        filterInp.addEventListener('input', filterTable);
      }
    })();
  </script>
</BaseLayout>
