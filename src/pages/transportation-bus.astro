---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Card from '../components/Card.astro';
import { BUS_SCHEDULE } from '../data/festival';
---
<BaseLayout title="Bus Timings | Mala Kalolsavam" active="transportation">
  <div class="main-container">
    <PageHead badge="Transportation · Bus" title="Bus Timings" intro="KSRTC and private departures from Mala Bus Stand." />
    <Card title="Mala Bus Stand" subtitle="KSRTC & Private · Daily" tone="blue">
      <div style="overflow-x:auto">
        <table class="tbl">
          <thead><tr><th>Departure</th><th>Route</th><th>Type</th><th>Notes</th></tr></thead>
          <tbody>
            {BUS_SCHEDULE.map((b) => (
              <tr>
                <td class="mono">{b.time}</td>
                <td>{b.route}</td>
                <td>{b.type}</td>
                <td class="text-muted">{b.notes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-muted sm" style="margin-top:.75rem">Schedules are indicative. Confirm at the bus stand enquiry counter (0480 2890 500).</p>
    </Card>
  </div>
</BaseLayout>
