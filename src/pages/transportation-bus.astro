---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import {
  MALA_TO_TSR, TSR_TO_MALA,
  MALA_TO_ALV, ALV_TO_MALA,
  MALA_TO_KDLR, KDLR_TO_MALA
} from '../data/festival';
---
<BaseLayout title="KSRTC Bus Timings & Boards | Mala Kalolsavam" active="transportation">
  <div class="main-container">
    <PageHead badge="KSRTC Mala Depot" title="KSRTC Bus Timings & Boards" intro="Official KSRTC departure timings and destination boards (ബോർഡ്) for all 3 key travel corridors to and from Mala." />

    <!-- Corridor Switcher -->
    <div class="corridor-toggle-wrapper">
      <button type="button" class="c-tab active" data-corridor="tsr">Thrissur (via Kodakara)</button>
      <button type="button" class="c-tab" data-corridor="alv">Aluva (via Annamanada)</button>
      <button type="button" class="c-tab" data-corridor="kdlr">Kodungallur (via Poyya)</button>
    </div>

    <!-- Direction Switcher -->
    <div class="dir-toggle-wrapper" style="margin-top:.75rem">
      <button type="button" class="dir-btn active" data-dir="from-mala">From Mala Stand</button>
      <button type="button" class="dir-btn" data-dir="to-mala">To Mala Stand (Return)</button>
    </div>

    <!-- Live Search -->
    <div class="card-base" style="margin:1.25rem 0;padding:1rem 1.25rem">
      <div class="search-input-box"><Icon name="search" class="search-icon" /><input id="board-search" type="search" class="inp inp-search" placeholder="Search by board name, stop or timing (e.g. Kodakara, 07:15, Poyya, Eravathur, Fast)..." autocomplete="off"></div>
    </div>

    <!-- 1. THRISSUR CORRIDOR -->
    <div id="corridor-tsr" class="corridor-view">
      <div id="box-from-mala-tsr" class="bus-table-box card-base dir-view" style="padding:0;overflow:hidden">
        <div style="overflow-x:auto">
          <table class="tbl minimal-tbl">
            <thead>
              <tr>
                <th style="width:7.5rem">Time</th>
                <th>Destination Board (ബസ് ബോർഡ്)</th>
                <th>Via / Key Stops</th>
                <th style="width:7rem;text-align:right">Type</th>
              </tr>
            </thead>
            <tbody>
              {MALA_TO_TSR.map((b) => (
                <tr data-search={`${b.time} ${b.board} ${b.via} ${b.type}`.toLowerCase()}>
                  <td class="mono time-cell">{b.time}</td>
                  <td class="board-cell"><strong>{b.board}</strong></td>
                  <td class="text-muted sm">{b.via}</td>
                  <td style="text-align:right"><span class="badge-gov sm-type">{b.type}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div id="box-to-mala-tsr" class="bus-table-box card-base dir-view" style="padding:0;overflow:hidden;display:none">
        <div style="overflow-x:auto">
          <table class="tbl minimal-tbl">
            <thead>
              <tr>
                <th style="width:7.5rem">Time</th>
                <th>Destination Board (ബസ് ബോർഡ്)</th>
                <th>Via / Key Stops</th>
                <th style="width:7rem;text-align:right">Type</th>
              </tr>
            </thead>
            <tbody>
              {TSR_TO_MALA.map((b) => (
                <tr data-search={`${b.time} ${b.board} ${b.via} ${b.type}`.toLowerCase()}>
                  <td class="mono time-cell">{b.time}</td>
                  <td class="board-cell"><strong>{b.board}</strong></td>
                  <td class="text-muted sm">{b.via}</td>
                  <td style="text-align:right"><span class="badge-gov sm-type">{b.type}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- 2. ALUVA CORRIDOR -->
    <div id="corridor-alv" class="corridor-view" style="display:none">
      <div id="box-from-mala-alv" class="bus-table-box card-base dir-view" style="padding:0;overflow:hidden">
        <div style="overflow-x:auto">
          <table class="tbl minimal-tbl">
            <thead>
              <tr>
                <th style="width:7.5rem">Time</th>
                <th>Destination Board (ബസ് ബോർഡ്)</th>
                <th>Via / Key Stops</th>
                <th style="width:7rem;text-align:right">Type</th>
              </tr>
            </thead>
            <tbody>
              {MALA_TO_ALV.map((b) => (
                <tr data-search={`${b.time} ${b.board} ${b.via} ${b.type}`.toLowerCase()}>
                  <td class="mono time-cell">{b.time}</td>
                  <td class="board-cell"><strong>{b.board}</strong></td>
                  <td class="text-muted sm">{b.via}</td>
                  <td style="text-align:right"><span class="badge-gov sm-type">{b.type}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div id="box-to-mala-alv" class="bus-table-box card-base dir-view" style="padding:0;overflow:hidden;display:none">
        <div style="overflow-x:auto">
          <table class="tbl minimal-tbl">
            <thead>
              <tr>
                <th style="width:7.5rem">Time</th>
                <th>Destination Board (ബസ് ബോർഡ്)</th>
                <th>Via / Key Stops</th>
                <th style="width:7rem;text-align:right">Type</th>
              </tr>
            </thead>
            <tbody>
              {ALV_TO_MALA.map((b) => (
                <tr data-search={`${b.time} ${b.board} ${b.via} ${b.type}`.toLowerCase()}>
                  <td class="mono time-cell">{b.time}</td>
                  <td class="board-cell"><strong>{b.board}</strong></td>
                  <td class="text-muted sm">{b.via}</td>
                  <td style="text-align:right"><span class="badge-gov sm-type">{b.type}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- 3. KODUNGALLUR CORRIDOR -->
    <div id="corridor-kdlr" class="corridor-view" style="display:none">
      <div id="box-from-mala-kdlr" class="bus-table-box card-base dir-view" style="padding:0;overflow:hidden">
        <div style="overflow-x:auto">
          <table class="tbl minimal-tbl">
            <thead>
              <tr>
                <th style="width:7.5rem">Time</th>
                <th>Destination Board (ബസ് ബോർഡ്)</th>
                <th>Via / Key Stops</th>
                <th style="width:7rem;text-align:right">Type</th>
              </tr>
            </thead>
            <tbody>
              {MALA_TO_KDLR.map((b) => (
                <tr data-search={`${b.time} ${b.board} ${b.via} ${b.type}`.toLowerCase()}>
                  <td class="mono time-cell">{b.time}</td>
                  <td class="board-cell"><strong>{b.board}</strong></td>
                  <td class="text-muted sm">{b.via}</td>
                  <td style="text-align:right"><span class="badge-gov sm-type">{b.type}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div id="box-to-mala-kdlr" class="bus-table-box card-base dir-view" style="padding:0;overflow:hidden;display:none">
        <div style="overflow-x:auto">
          <table class="tbl minimal-tbl">
            <thead>
              <tr>
                <th style="width:7.5rem">Time</th>
                <th>Destination Board (ബസ് ബോർഡ്)</th>
                <th>Via / Key Stops</th>
                <th style="width:7rem;text-align:right">Type</th>
              </tr>
            </thead>
            <tbody>
              {KDLR_TO_MALA.map((b) => (
                <tr data-search={`${b.time} ${b.board} ${b.via} ${b.type}`.toLowerCase()}>
                  <td class="mono time-cell">{b.time}</td>
                  <td class="board-cell"><strong>{b.board}</strong></td>
                  <td class="text-muted sm">{b.via}</td>
                  <td style="text-align:right"><span class="badge-gov sm-type">{b.type}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <p id="no-board-match" class="text-muted center" style="margin-top:2.5rem" hidden>No bus boards match your search.</p>
  </div>

  <style>
    .corridor-toggle-wrapper {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .c-tab {
      flex: 1;
      min-width: 140px;
      padding: 0.75rem 1rem;
      border-radius: var(--radius-inner);
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text-heading);
      font-weight: 700;
      font-size: 0.92rem;
      cursor: pointer;
      transition: all 0.15s ease;
      text-align: center;
    }
    .c-tab:hover { background: var(--bg-alt); }
    .c-tab.active {
      background: var(--brand);
      color: var(--on-brand);
      border-color: var(--brand);
      box-shadow: 0 4px 12px rgba(27, 46, 32, 0.2);
    }
    .dir-toggle-wrapper {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .dir-btn {
      flex: 1;
      padding: 0.6rem 1rem;
      border-radius: var(--radius-pill);
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--muted);
      font-weight: 600;
      font-size: 0.88rem;
      cursor: pointer;
      transition: all 0.15s ease;
      text-align: center;
    }
    .dir-btn:hover { background: var(--bg-alt); color: var(--text); }
    .dir-btn.active {
      background: var(--accent);
      color: #ffffff;
      border-color: var(--accent);
      font-weight: 700;
    }
    .minimal-tbl th {
      padding: 0.85rem 1.25rem;
      background: var(--bg-alt);
    }
    .minimal-tbl td {
      padding: 0.85rem 1.25rem;
    }
    .time-cell {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--brand);
    }
    .board-cell {
      font-size: 0.95rem;
      color: var(--text-heading);
      letter-spacing: 0.02em;
    }
    .sm-type {
      font-size: 0.72rem;
      padding: 0.2rem 0.55rem;
    }
  </style>

  <script is:inline>
    (function(){
      var cTabs = document.querySelectorAll('.c-tab');
      var dirBtns = document.querySelectorAll('.dir-btn');
      var searchInp = document.getElementById('board-search');
      var emptyNotice = document.getElementById('no-board-match');

      var curCorridor = 'tsr';
      var curDir = 'from-mala';

      function syncViews(){
        cTabs.forEach(function(b){
          b.classList.toggle('active', b.getAttribute('data-corridor') === curCorridor);
        });
        dirBtns.forEach(function(b){
          b.classList.toggle('active', b.getAttribute('data-dir') === curDir);
        });

        ['tsr', 'alv', 'kdlr'].forEach(function(c){
          var cEl = document.getElementById('corridor-' + c);
          if (cEl) cEl.style.display = (c === curCorridor) ? '' : 'none';
        });

        var fromBox = document.getElementById('box-from-mala-' + curCorridor);
        var toBox = document.getElementById('box-to-mala-' + curCorridor);
        if (fromBox) fromBox.style.display = (curDir === 'from-mala') ? '' : 'none';
        if (toBox) toBox.style.display = (curDir === 'to-mala') ? '' : 'none';

        filterCurrent();
      }

      function filterCurrent(){
        var q = (searchInp ? searchInp.value : '').trim().toLowerCase();
        var tokens = q.split(/\s+/).filter(Boolean);
        var activeBox = document.getElementById('box-' + curDir + '-' + curCorridor);
        if (!activeBox) return;
        var rows = Array.from(activeBox.querySelectorAll('tbody tr'));
        var visibleCount = 0;

        rows.forEach(function(r){
          var txt = r.getAttribute('data-search') || '';
          var matches = (!tokens.length) || tokens.every(function(t){ return txt.indexOf(t) >= 0; });
          if (matches){
            r.style.display = '';
            visibleCount++;
          } else {
            r.style.display = 'none';
          }
        });

        if (emptyNotice){
          emptyNotice.hidden = visibleCount > 0;
        }
      }

      cTabs.forEach(function(b){
        b.addEventListener('click', function(){
          curCorridor = b.getAttribute('data-corridor');
          syncViews();
        });
      });

      dirBtns.forEach(function(b){
        b.addEventListener('click', function(){
          curDir = b.getAttribute('data-dir');
          syncViews();
        });
      });

      if (searchInp){
        searchInp.addEventListener('input', filterCurrent);
      }
    })();
  </script>
</BaseLayout>
