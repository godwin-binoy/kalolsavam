---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Card from '../components/Card.astro';
import ActionItem from '../components/ActionItem.astro';
import { FACILITIES } from '../data/festival';
---
<BaseLayout title="Facilities | Mala Kalolsavam" active="facilities">
  <div class="main-container">
    <PageHead badge="Module 04 · Facilities" title="All Campus Facilities" intro="Everything you need — green rooms, toilets, drinking water, dining hall, help desk, medical room, and sanitary facilities." />
    <div class="grid-3">
      {FACILITIES.map((f) => (
        <Card title={f.title} titleI18n={f.titleI18n} subtitle={f.sub} subtitleI18n={f.subI18n} tone={f.tone} href={f.href}>
          <p class="text-muted sm" data-i18n={f.descI18n || undefined}>{f.desc}</p>
          <div class="fest-action-item">
            <span><strong>Location:</strong> {f.location}</span>
          </div>
        </Card>
      ))}
    </div>
  </div>
</BaseLayout>
