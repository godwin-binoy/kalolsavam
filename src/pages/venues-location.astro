---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Card from '../components/Card.astro';
import ActionItem from '../components/ActionItem.astro';
import stages from '../data/stages.json';
---
<BaseLayout title="Venue Locations | Mala Kalolsavam" active="venues">
  <div class="main-container">
    <PageHead badge="Module 01 · Location" title="Venue Locations" intro="All 9 stages at the Mala Sub-District Kalolsavam. Tap a stage for its blueprint, directions, live status, and schedule." />
    <div class="grid-3">
      {stages.map((s) => (
        <Card href={`/venues-stage/${s.n}`} title={s.name} badge={`Stage ${s.n}`} tone={s.banner ? s.banner.replace('banner-', '') : 'blue'} icon={s.icon ? s.icon.replace('.svg', '') : 'map-pin'}>
          <p class="text-muted sm">{s.short}</p>
          <ActionItem href={`/venues-stage/${s.n}`} icon="map-pin" iconTone="c-emerald" title={s.loc} />
        </Card>
      ))}
    </div>
  </div>
</BaseLayout>
