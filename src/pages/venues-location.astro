---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Card from '../components/Card.astro';
import ActionItem from '../components/ActionItem.astro';
import stages from '../data/stages.json';

const sortedVenues = [...stages].sort((a, b) => a.n - b.n);
---
<BaseLayout title="All Venues | Mala Kalolsavam" active="venues">
  <div class="main-container">
    <PageHead badge="Locations" title="All 26 Festival Venues" intro="Complete list of on-stage and off-stage venues at St. Antonys HSS Mala. Ordered by Venue Number." />
    <div class="grid-3">
      {sortedVenues.map((s) => (
        <Card title={s.name} badge={`Venue ${s.n}`} tone={s.kind === 'stage' ? 'rose' : 'blue'} icon={s.icon ? s.icon.replace('.svg', '') : 'map-pin'}>
          <p class="text-muted sm">{s.short}</p>
          <div class="fest-action-item">
            <span class="left">
              <span class={`fest-item-icon ${s.kind === 'stage' ? 'c-rose' : 'c-blue'}`}>
                <span class="icn" style={`--icon-url:url('/assets/svg/map-pin.svg')`}></span>
              </span>
              <span><strong>Location:</strong> {s.loc}</span>
            </span>
          </div>
        </Card>
      ))}
    </div>
  </div>
</BaseLayout>
