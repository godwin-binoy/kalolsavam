---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Card from '../components/Card.astro';
import ActionItem from '../components/ActionItem.astro';
---
<BaseLayout title="Help & Emergency | Mala Kalolsavam" active="help">
  <div class="main-container">
    <PageHead badge="Emergency & Committee Desk" badgeClass="badge-emergency" title="Help Desk & Emergency Directory" titleI18n="help.title" intro="Official Programme Committee contacts, Stage Committee desk, and First Aid / Medical unit." />
    <div class="grid-2" style="margin-bottom:2rem">
      <Card title="Programme Committee Chairman" subtitle="Saji C. Paulose · Programme Chair" tone="purple" icon="building">
        <p style="color:var(--text);font-size:.95rem;margin-bottom:.75rem">For official committee matters, schedule clarifications, and programme coordination.</p>
        <ActionItem href="tel:9947462072" external={true} title="Call Chairman · 9947462072" icon="phone" iconTone="c-indigo" />
      </Card>
      <Card title="Programme Committee Convener" subtitle="Haritha C. A. · Programme Convener" tone="indigo" icon="user">
        <p style="color:var(--text);font-size:.95rem;margin-bottom:.75rem">For chest number reporting, schedule rescheduling, and error reporting.</p>
        <ActionItem href="tel:9995078473" external={true} title="Call Convener · 9995078473" icon="phone" iconTone="c-indigo" />
      </Card>
      <Card title="Stage Committee Convener" subtitle="Sajeevan K. C. · LAUPS Konathukunnu" tone="blue" icon="map-pin">
        <p style="color:var(--text);font-size:.95rem;margin-bottom:.75rem">For venue arrangements, stage readiness, and on-site stage desk support.</p>
        <ActionItem href="tel:9497458116" external={true} title="Call Stage Convener · 9497458116" icon="phone" iconTone="c-blue" />
      </Card>
      <Card title="Medical Unit" titleI18n="help.medical.title" subtitle="First Aid · 24/7 Standby" subtitleI18n="help.medical.sub" tone="rose" icon="medical">
        <p style="color:var(--text);font-size:.95rem;margin-bottom:.75rem" data-i18n="help.medical.desc">Physicians, nursing staff, and emergency medical ambulance available on campus during festival hours.</p>
        <ActionItem href="tel:9744686093" external={true} title="Call Medical Unit" titleI18n="btn.call_now" icon="phone" iconTone="c-rose" style="background:var(--badge-emergency-bg);border-color:var(--badge-emergency-border)" />
      </Card>
    </div>
  </div>
</BaseLayout>
