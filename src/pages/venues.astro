---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Card from '../components/Card.astro';
import ActionItem from '../components/ActionItem.astro';
---
<BaseLayout title="Stages & Venues | Mala Kalolsavam" active="venues">
  <div class="main-container">
    <PageHead badge="Module 01 · Stages & Venues" title="Stages & Venues" intro="Pick what you need: venue location, find a venue by competition item, or follow live on-stage updates." />
    <div class="grid-3">
      <Card href="/venues-location" title="Location" subtitle="Where is it?" tone="blue" icon="map-pin">
        <p class="text-muted sm">Every stage, hall, and ground on campus — with walking directions from the main gate.</p>
        <ActionItem href="/venues-location" title="Open Venue Locations" />
      </Card>
      <Card href="/venues-find" title="Find by Item" subtitle="Which venue?" tone="purple" icon="search">
        <p class="text-muted sm">Type your item code or name — we'll show its venue, day, and scheduled time.</p>
        <ActionItem href="/venues-find" title="Search Items" />
      </Card>
      <Card href="/venues-live" title="Live Updates" subtitle="On-stage Tracker" tone="teal" icon="bolt">
        <p class="text-muted sm">Real-time chest numbers, queues, delays, and stage announcements.</p>
        <ActionItem href="/venues-live" title="Open Live Tracker" />
      </Card>
    </div>
  </div>
</BaseLayout>
