---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Card from '../components/Card.astro';
import ActionItem from '../components/ActionItem.astro';
import { AUTO_DRIVERS } from '../data/festival';
---
<BaseLayout title="Auto Drivers | Mala Kalolsavam" active="transportation">
  <div class="main-container">
    <PageHead badge="Transportation · Auto" title="Auto Drivers" intro="Verified auto-rickshaw drivers in the Mala area. Tap a number to call." />
    <div class="grid-3">
      {AUTO_DRIVERS.map((d) => (
        <Card title={d.name} subtitle={d.sub} tone="purple">
          <p class="text-muted sm">{d.desc}</p>
          <ActionItem href={`tel:${d.phone}`} external={true} arrow={false} icon="phone" iconTone="c-emerald">
            <span class="mono">{d.phone}</span>
          </ActionItem>
        </Card>
      ))}
    </div>
  </div>
</BaseLayout>
