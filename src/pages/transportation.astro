---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Card from '../components/Card.astro';
import ActionItem from '../components/ActionItem.astro';
---
<BaseLayout title="Transportation | Mala Kalolsavam" active="transportation">
  <div class="main-container">
    <PageHead badge="Module 06 · Transportation" title="Transportation" intro="Bus timings and auto-rickshaw drivers near St. Antony's HSS Mala. Pick what you need." />
    <div class="grid-2">
      <Card href="/transportation-bus" title="Bus Timings" titleI18n="trans.bus.title" subtitle="KSRTC & Private · Mala Stand" subtitleI18n="trans.bus.sub" tone="blue">
        <p class="text-muted sm" data-i18n="trans.bus.desc">Departures from Mala Bus Stand — route, type, and timing at a glance.</p>
        <ActionItem href="/transportation-bus" title="Open Bus Schedule" titleI18n="trans.bus.btn" />
      </Card>
      <Card href="/transportation-auto" title="Auto Drivers" titleI18n="trans.auto.title" subtitle="Auto-Rickshaw · Mala Area" subtitleI18n="trans.auto.sub" tone="purple">
        <p class="text-muted sm" data-i18n="trans.auto.desc">Verified auto drivers in the Mala area — tap a card to call directly.</p>
        <ActionItem href="/transportation-auto" title="View Auto Drivers" titleI18n="trans.auto.btn" />
      </Card>
    </div>
  </div>
</BaseLayout>
