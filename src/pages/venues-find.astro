---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Card from '../components/Card.astro';
import ActionItem from '../components/ActionItem.astro';
import { FESTIVAL_SCHEDULE } from '../data/schedule';
import { url } from '../lib/url';

const CATEGORIES = [
  { slug: "lp-general", name: "LP General", tone: "blue", icon: "sparkle", desc: "Lower Primary General (Classes 1–4)" },
  { slug: "up-general", name: "UP General", tone: "teal", icon: "user", desc: "Upper Primary General (Classes 5–7)" },
  { slug: "hs-general", name: "HS General", tone: "indigo", icon: "building", desc: "High School General (Classes 8–10)" },
  { slug: "hss-general", name: "HSS General", tone: "purple", icon: "grid", desc: "Higher Secondary General (Classes 11–12)" },
  { slug: "up-sanskrit", name: "UP Sanskrit", tone: "orange", icon: "clipboard-check", desc: "UP Sanskrit Sahithyolsavam" },
  { slug: "hs-sanskrit", name: "HS Sanskrit", tone: "pink", icon: "clipboard-check", desc: "HS Sanskrit Sahithyolsavam" },
  { slug: "lp-arabic", name: "LP Arabic", tone: "rose", icon: "sparkle", desc: "LP Arabic Sahithyolsavam" },
  { slug: "up-arabic", name: "UP Arabic", tone: "teal", icon: "user", desc: "UP Arabic Sahithyolsavam" },
  { slug: "hs-arabic", name: "HS Arabic", tone: "blue", icon: "building", desc: "HS Arabic Sahithyolsavam" },
];

const categoryCards = CATEGORIES.map((c) => {
  const count = FESTIVAL_SCHEDULE.filter((it) => it.cat === c.name).length;
  const sampleItems = FESTIVAL_SCHEDULE.filter((it) => it.cat === c.name).slice(0, 3).map((x) => x.item);
  return {
    ...c,
    count,
    sample: sampleItems.join(", "),
  };
});
---
<BaseLayout title="Find Venue by Item | Mala Kalolsavam" active="venues">
  <div class="main-container">
    <PageHead badge="Item Categories" title="Find Venue by Item" intro="Select any category below to view all competitions, assigned venues, locations, and timings." />

    <!-- Instant Search across all Categories -->
    <div class="card-base" style="margin-bottom:2.5rem">
      <label for="q-global" class="text-muted sm" style="display:block;margin-bottom:.5rem;font-weight:600">Quick Search Any Category or Item Name:</label>
      <input id="q-global" type="search" class="inp" placeholder="Type category or item name — e.g. LP, Sanskrit, Oppana, Bharathanatyam…" autocomplete="off">
    </div>

    <!-- Category Cards Grid -->
    <div id="cat-cards-grid" class="grid-3" style="gap:1.5rem">
      {categoryCards.map((c) => (
        <div class="cat-card-wrapper" data-cat-text={`${c.name} ${c.slug} ${c.desc} ${c.sample}`.toLowerCase()}>
          <Card title={c.name} badge={`${c.count} Events`} tone={c.tone} icon={c.icon} href={`/category/${c.slug}`}>
            <p class="text-muted sm" style="margin:0 0 .5rem">{c.desc}</p>
            {c.sample && (
              <div class="text-muted xs" style="line-height:1.4;margin-bottom:.75rem">
                <strong>Includes:</strong> {c.sample}...
              </div>
            )}
            <ActionItem href={`/category/${c.slug}`} title={`View ${c.name} Schedule`} iconTone={`c-${c.tone}`} />
          </Card>
        </div>
      ))}
    </div>

    <p id="empty-cat-cards" class="text-muted center" style="margin-top:3rem" hidden>No matching categories found.</p>
  </div>

  <script is:inline>
    (function(){
      var q = document.getElementById('q-global');
      var grid = document.getElementById('cat-cards-grid');
      var emp = document.getElementById('empty-cat-cards');
      if (!q || !grid) return;
      var cards = Array.from(grid.querySelectorAll('.cat-card-wrapper'));

      q.addEventListener('input', function(){
        var val = q.value.trim().toLowerCase();
        var tokens = val.split(/\s+/).filter(Boolean);
        var visibleCount = 0;

        cards.forEach(function(card){
          var txt = card.getAttribute('data-cat-text') || '';
          var matches = (!tokens.length) || tokens.every(function(t){ return txt.indexOf(t) >= 0; });
          if (matches){
            card.style.display = '';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (emp) emp.hidden = visibleCount > 0;
      });
    })();
  </script>
</BaseLayout>
