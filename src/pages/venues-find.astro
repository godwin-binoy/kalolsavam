---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { FESTIVAL_SCHEDULE } from '../data/schedule';
import stages from '../data/stages.json';
import { BASE, url } from '../lib/url';

const CATEGORIES = [
  { slug: "lp-general", name: "LP General", tone: "blue" },
  { slug: "up-general", name: "UP General", tone: "teal" },
  { slug: "hs-general", name: "HS General", tone: "indigo" },
  { slug: "hss-general", name: "HSS General", tone: "purple" },
  { slug: "up-sanskrit", name: "UP Sanskrit", tone: "orange" },
  { slug: "hs-sanskrit", name: "HS Sanskrit", tone: "pink" },
  { slug: "lp-arabic", name: "LP Arabic", tone: "rose" },
  { slug: "up-arabic", name: "UP Arabic", tone: "teal" },
  { slug: "hs-arabic", name: "HS Arabic", tone: "blue" },
];

const categoryTiles = CATEGORIES.map((c) => {
  const count = FESTIVAL_SCHEDULE.filter((it) => it.cat === c.name).length;
  return { ...c, count };
});

const venueMap: Record<number, { name: string; loc: string }> = {};
for (const s of stages) {
  venueMap[s.n] = { name: s.name, loc: s.loc };
}

const allScheduleItems = FESTIVAL_SCHEDULE.map((it) => ({
  ...it,
  venue_name: venueMap[it.venue_n]?.name || `Venue ${it.venue_n}`,
  venue_loc: venueMap[it.venue_n]?.loc || '',
}));
---
<BaseLayout title="Find Venue by Item | Mala Kalolsavam" active="venues">
  <div class="main-container">
    <PageHead badge="Categories & Items" title="Find Venue by Item" intro="Select a category below or search any item name to view its competition venue, blueprints, and schedule." />

    <!-- Search Input -->
    <div class="card-base" style="margin-bottom:2rem;padding:1.25rem">
      <input id="q-global" type="search" class="inp" placeholder="Search by item name or category — e.g. Oppana, Bharathanatyam, Sanskrit, LP…" autocomplete="off">
    </div>

    <!-- Category Squircle Buttons -->
    <div id="cat-tiles-grid" class="cat-grid">
      {categoryTiles.map((c) => (
        <a href={url(`/category/${c.slug}`)} class={`cat-tile banner-${c.tone}`} data-cat-text={`${c.name} ${c.slug}`.toLowerCase()}>
          <div class="tile-content">
            <span class="tile-badge">{c.count} Events</span>
            <h2 class="tile-title">{c.name}</h2>
          </div>
          <span class="tile-arrow">&rarr;</span>
        </a>
      ))}
    </div>

    <!-- Direct Matching Item Results Grid (Shown when searching) -->
    <div id="direct-items-grid" class="grid-3" style="margin-top:2rem;gap:1.25rem;display:none">
      {allScheduleItems.map((it) => (
        <a href={url(`/venues-stage/${it.venue_n}`)} class="fest-card direct-item-card" data-item-search={`${it.item} ${it.cat} ${it.venue_name} ${it.venue_loc}`.toLowerCase()} style="text-decoration:none;color:inherit;display:none">
          <div class="fest-header banner-blue" style="padding:.9rem 1.15rem">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.25rem">
              <span style="font-size:.72rem;padding:.15rem .55rem;background:rgba(255,255,255,.2);border-radius:999px;font-weight:700">Venue #{it.venue_n}</span>
              <span style="font-size:.72rem;opacity:.9">{it.cat}</span>
            </div>
            <h3 class="fest-title" style="font-size:1.05rem">{it.item}</h3>
          </div>
          <div class="fest-body" style="padding:.9rem 1.1rem;gap:.4rem;font-size:.85rem">
            <div><strong>Venue:</strong> {it.venue_name}</div>
            <div class="text-muted xs">{it.venue_loc}</div>
            <div style="margin-top:auto;color:var(--brand);font-weight:700;font-size:.8rem;padding-top:.4rem;border-top:1px solid var(--border)">
              View Venue Blueprints &rarr;
            </div>
          </div>
        </a>
      ))}
    </div>

    <p id="empty-cat-cards" class="text-muted center" style="margin-top:3rem" hidden>No matching items or categories found.</p>
  </div>

  <style>
    .cat-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    @media (min-width: 600px) {
      .cat-grid { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
    }
    @media (min-width: 960px) {
      .cat-grid { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
    }
    .cat-tile {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.35rem 1.6rem;
      border-radius: 1.25rem;
      color: #ffffff !important;
      text-decoration: none;
      box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.25);
      border: 1px solid rgba(255, 255, 255, 0.15);
      transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.18s ease;
      cursor: pointer;
      user-select: none;
    }
    .cat-tile:hover {
      transform: translateY(-3px) scale(1.015);
      box-shadow: 0 14px 28px -8px rgba(0, 0, 0, 0.35);
    }
    .tile-content {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      min-width: 0;
    }
    .tile-badge {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      background: rgba(255, 255, 255, 0.22);
      padding: 0.2rem 0.65rem;
      border-radius: 999px;
      width: fit-content;
    }
    .tile-title {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      margin: 0;
      color: #ffffff;
      line-height: 1.15;
      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.25);
    }
    .tile-arrow {
      font-size: 1.5rem;
      font-weight: 700;
      opacity: 0.85;
      transition: transform 0.18s ease;
      flex-shrink: 0;
      margin-left: 0.75rem;
    }
  </style>

  <script is:inline>
    (function(){
      var q = document.getElementById('q-global');
      var tileGrid = document.getElementById('cat-tiles-grid');
      var itemGrid = document.getElementById('direct-items-grid');
      var emp = document.getElementById('empty-cat-cards');
      if (!q) return;

      var tiles = Array.from(tileGrid.querySelectorAll('.cat-tile'));
      var itemCards = Array.from(itemGrid.querySelectorAll('.direct-item-card'));

      q.addEventListener('input', function(){
        var val = q.value.trim().toLowerCase();
        var tokens = val.split(/\s+/).filter(Boolean);

        if (!tokens.length){
          tiles.forEach(function(t){ t.style.display = 'flex'; });
          tileGrid.style.display = 'grid';
          itemGrid.style.display = 'none';
          itemCards.forEach(function(c){ c.style.display = 'none'; });
          if (emp) emp.hidden = true;
          return;
        }

        var visibleTiles = 0;
        tiles.forEach(function(t){
          var txt = t.getAttribute('data-cat-text') || '';
          var matches = tokens.every(function(tk){ return txt.indexOf(tk) >= 0; });
          t.style.display = matches ? 'flex' : 'none';
          if (matches) visibleTiles++;
        });

        var visibleItems = 0;
        itemCards.forEach(function(c){
          var txt = c.getAttribute('data-item-search') || '';
          var matches = tokens.every(function(tk){ return txt.indexOf(tk) >= 0; });
          c.style.display = matches ? 'flex' : 'none';
          if (matches) visibleItems++;
        });

        itemGrid.style.display = visibleItems > 0 ? 'grid' : 'none';
        if (emp) emp.hidden = (visibleTiles + visibleItems) > 0;
      });
    })();
  </script>
</BaseLayout>
