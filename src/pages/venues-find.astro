---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BASE } from '../lib/url';
import PageHead from '../components/PageHead.astro';
import { FESTIVAL_SCHEDULE } from '../data/schedule';
import stages from '../data/stages.json';

const venueMap: Record<number, { name: string; loc: string }> = {};
for (const s of stages) {
  venueMap[s.n] = { name: s.name, loc: s.loc };
}

const scheduleWithDetails = FESTIVAL_SCHEDULE.map((it) => ({
  ...it,
  venue_name: venueMap[it.venue_n]?.name || `Venue ${it.venue_n}`,
  venue_loc: venueMap[it.venue_n]?.loc || '',
}));
---
<BaseLayout title="Find Venue by Item | Mala Kalolsavam" active="venues">
  <div class="main-container">
    <PageHead badge="Item Finder" title="Find Venue by Item" intro="Search any competition item name or category — venue, date, and timing will be displayed immediately." />
    <div class="card-base" style="margin-bottom:1.5rem">
      <input id="q" type="search" class="inp" placeholder="Type item name in Manglish — e.g. Oppana, Bharathanatyam, Sanghanritham, Kolkali…" autocomplete="off">
      <p class="text-muted sm" style="margin:.5rem 0 0">Try: Oppana · Bharathanatyam · Sanghanritham · Margamkali · Kolkali · Duffmuttu · Vattappattu</p>
    </div>
    <div id="results" class="grid-2"></div>
    <p id="empty" class="text-muted center" style="margin-top:2rem" hidden>No matching items found.</p>
  </div>
  <script is:inline define:vars={{ BASE, scheduleWithDetails }}>
    (function(){
      var q = document.getElementById('q'), res = document.getElementById('results'), emp = document.getElementById('empty');
      if (!q || !res || !emp) return;

      function esc(s){ return window.Kal ? window.Kal.esc(s) : String(s || ''); }

      function render(filter){
        var tokens = (filter || '').trim().toLowerCase().split(/\s+/).filter(Boolean);
        var matches = scheduleWithDetails.filter(function(e){
          if (!tokens.length) return true;
          var txt = (e.item + ' ' + e.cat + ' ' + e.venue_name + ' ' + e.venue_loc + ' ' + e.day + ' ' + e.time).toLowerCase();
          return tokens.every(function(t){ return txt.indexOf(t) >= 0; });
        });

        emp.hidden = matches.length > 0;
        res.innerHTML = matches.slice(0, 80).map(function(e){
          return '<div class="fest-card"><div class="fest-header banner-blue">' +
            '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.25rem">' +
              '<span style="font-size:.75rem;padding:.2rem .65rem;background:rgba(255,255,255,.2);border-radius:999px;font-weight:700">Venue #' + e.venue_n + '</span>' +
              '<span style="font-size:.75rem;opacity:.9;font-weight:600">' + esc(e.cat) + '</span>' +
            '</div><h3 class="fest-title" style="font-size:1.15rem">' + esc(e.item) + '</h3></div>' +
            '<div class="fest-body">' +
              '<div class="fest-action-item"><span class="left"><span class="fest-item-icon c-rose"><span class="icn" style="--icon-url:url(\'' + BASE + 'assets/svg/map-pin.svg\')"></span></span><span><strong>Venue:</strong> ' + esc(e.venue_name) + ' (' + esc(e.venue_loc) + ')</span></span></div>' +
              '<div class="fest-action-item"><span class="left"><span class="fest-item-icon c-amber"><span class="icn" style="--icon-url:url(\'' + BASE + 'assets/svg/bolt.svg\')"></span></span><span><strong>Schedule:</strong> ' + esc(e.day) + ' · ' + esc(e.time) + '</span></span></div>' +
            '</div></div>';
        }).join('');
      }

      render('');
      q.addEventListener('input', function(){ render(q.value); });
    })();
  </script>
</BaseLayout>
