---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BASE, url } from '../lib/url';
import PageHead from '../components/PageHead.astro';
const resultsUrl = "https://kalolsavam.kerala.gov.in/";
const items = ["Oppana","Margamkali","Nadan Pattu","Group Dance","Drama"];
---
<BaseLayout title="Group Stage Results | Mala Kalolsavam" active="">
  <div class="main-container">
    <PageHead badge="Results · Group Stage" title="Group Stage Results" intro="Select an item to view the declared results on the official government portal." />
    <div class="grid-2" style="max-width:900px">
      {items.map((item) => (
        <a href={resultsUrl} target="_blank" rel="noopener" class="fest-action-item" style="padding:1.25rem 1.5rem">
          <span class="left"><span style="font-weight:600;font-size:1.05rem">{item}</span></span>
          <span class="fest-arrow" style={`--icon-url:url('${BASE}assets/svg/arrow-right.svg')`}></span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
