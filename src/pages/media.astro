---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Card from '../components/Card.astro';
import ActionItem from '../components/ActionItem.astro';
---
<BaseLayout title="Media & Streaming | Mala Kalolsavam" active="media">
  <div class="main-container">
    <PageHead badge="Module 03 · Media Room" title="Media & Live Streaming" intro="Official photographs and live broadcasts from the festival stages." />
    <div class="grid-2">
      <Card title="Stage Photos" titleI18n="media.photo.title" subtitle="Official Media Gallery" subtitleI18n="media.photo.sub" tone="pink" icon="grid">
        <p class="text-muted sm" data-i18n="media.photo.desc">High-resolution photographs uploaded by the media room. Search by item or chest number.</p>
        <div class="fest-action-item" style="opacity:0.6"><span data-i18n="media.photo.soon">Gallery coming soon</span></div>
      </Card>
      <Card title="Live Streaming" titleI18n="media.live.title" subtitle="Watch Online" subtitleI18n="media.live.sub" tone="rose" icon="video">
        <p class="text-muted sm" data-i18n="media.live.desc">Watch the Main Stage live. Stream begins 15 minutes before the first event.</p>
        <ActionItem href="https://youtube.com" external={true} title="Watch Main Stage" titleI18n="media.live.btn" icon="video" iconTone="c-rose" />
      </Card>
    </div>
  </div>
</BaseLayout>
