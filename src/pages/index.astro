---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BASE, url } from '../lib/url';

const svg = (name) => `--icon-url:url('${BASE}assets/svg/${name}.svg')`;
---
<BaseLayout active="home">
  <section class="hero">
    <div class="hero-in">
      <div class="hero-text">
        <span class="badge-gov" data-i18n="hero.badge">One Kalolsavam, One Platform</span>
        <h1 class="page-title" data-i18n="hero.title">Mala Sub-District<br>School Kalolsavam</h1>
        <p data-i18n="hero.desc">Welcome to the official web desk for participants, parents, and teachers. Track real-time stage events, access verified result declarations, and download stage photographs.</p>
        <div class="row hero-cta">
          <a class="btn-primary dark" href="#services" data-i18n="btn.explore">Explore Services</a>
          <a class="btn-primary ghost" href={url('/venues-live')} data-i18n="btn.live">Live Stages</a>
        </div>
      </div>
      <div class="hero-mark">
        <img src={BASE + 'assets/img/master-logo.webp'} alt="Kalolsavam Master Logo" width="380" height="380" decoding="async">
      </div>
    </div>
  </section>

  <section id="services" class="main-container">
    <div class="sec-head" style="margin-bottom:1.75rem">
      <h2 class="section-title" data-i18n="sec.services">Festival Services &amp; Portals</h2>
      <p data-i18n="sec.services.desc">Search literally anything — stage numbers, items, bus routes, toilets, lunch, medical, or results</p>
    </div>

    <!-- Universal Smart Search Bar -->
    <div class="search-wrapper" style="margin: 0.5rem auto 1rem auto; max-width: 44rem;">
      <div class="search-input-box" style="position:relative;display:flex;align-items:center;">
        <span style={`position:absolute;left:1.35rem;width:1.25rem;height:1.25rem;color:#1D4ED8;pointer-events:none;z-index:10;${svg('search')}`} class="icn"></span>
        <input id="global-search" type="search" placeholder="Search anything" data-i18n-placeholder="search.placeholder" autocomplete="off" spellcheck="false" style="text-align:center;padding-left:3.5rem;padding-right:3.5rem;">
      </div>
      <div id="search-results-dropdown" class="hidden" style="position:absolute;top:calc(100% + .5rem);left:0;right:0;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius-card);box-shadow:0 16px 36px -8px rgba(15,23,42,.2);z-index:60;max-height:26rem;overflow-y:auto;padding:.6rem"></div>
    </div>

    <div class="grid-3">

      <!-- 1 · STAGES & VENUES -->
      <div class="fest-card">
        <div class="fest-header banner-blue">
          <h3 class="fest-title" data-i18n="card.stages.title">Stages &amp; Venues</h3>
          <span class="fest-subtitle" data-i18n="card.stages.sub">Module 01 · Live Tracker</span>
          <span class="fest-watermark" style={svg('map-pin')}></span>
        </div>
        <div class="fest-body">
          <a class="fest-action-item" href={url('/venues-location')}>
            <span class="left">
              <span class="fest-item-icon c-emerald"><span class="icn" style={svg('map-pin')}></span></span>
              <span data-i18n="card.stages.loc">Location</span>
            </span>
            <span class="fest-arrow" style={svg('arrow-right')}></span>
          </a>
          <a class="fest-action-item" href={url('/venues-find')}>
            <span class="left">
              <span class="fest-item-icon c-indigo"><span class="icn" style={svg('search')}></span></span>
              <span data-i18n="card.stages.find">Find by Item</span>
            </span>
            <span class="fest-arrow" style={svg('arrow-right')}></span>
          </a>
          <a class="fest-action-item" href={url('/venues-live')}>
            <span class="left">
              <span class="fest-item-icon c-rose"><span class="icn" style={svg('bolt')}></span></span>
              <span data-i18n="card.stages.live">Live Updates</span>
            </span>
            <span class="fest-arrow" style={svg('arrow-right')}></span>
          </a>
        </div>
      </div>

      <!-- 2 · FACILITIES -->
      <div class="fest-card">
        <div class="fest-header banner-teal">
          <h3 class="fest-title" data-i18n="card.fac.title">Facilities</h3>
          <span class="fest-subtitle" data-i18n="card.fac.sub">Module 04 · Campus Facilities</span>
          <span class="fest-watermark" style={svg('sparkle')}></span>
        </div>
        <div class="fest-body">
          <a class="fest-action-item" href={url('/facilities-green-room')}>
            <span class="left">
              <span class="fest-item-icon c-teal"><span class="icn" style={svg('user')}></span></span>
              <span data-i18n="card.fac.green">Green Room</span>
            </span>
            <span class="fest-arrow" style={svg('arrow-right')}></span>
          </a>
          <a class="fest-action-item" href={url('/facilities-toilet')}>
            <span class="left">
              <span class="fest-item-icon c-blue"><span class="icn" style={svg('water')}></span></span>
              <span data-i18n="card.fac.toilet">Toilet</span>
            </span>
            <span class="fest-arrow" style={svg('arrow-right')}></span>
          </a>
          <a class="fest-action-item" href={url('/facilities')}>
            <span class="left">
              <span class="fest-item-icon c-indigo"><span class="icn" style={svg('grid')}></span></span>
              <span data-i18n="card.fac.all">See All</span>
            </span>
            <span class="fest-arrow" style={svg('arrow-right')}></span>
          </a>
        </div>
      </div>

      <!-- 3 · MEDIA & STREAMING -->
      <div class="fest-card">
        <div class="fest-header banner-pink">
          <h3 class="fest-title" data-i18n="card.media.title">Media &amp; Streaming</h3>
          <span class="fest-subtitle" data-i18n="card.media.sub">Module 03 · Official Media</span>
          <span class="fest-watermark" style={svg('video')}></span>
        </div>
        <div class="fest-body">
          <a class="fest-action-item" href={url('/media')}>
            <span class="left">
              <span class="fest-item-icon c-blue"><span class="icn" style={svg('grid')}></span></span>
              <span data-i18n="card.media.photos">Stage Photos</span>
            </span>
            <span class="fest-arrow" style={svg('arrow-right')}></span>
          </a>
          <a class="fest-action-item" href={url('/media')}>
            <span class="left">
              <span class="fest-item-icon c-rose"><span class="icn" style={svg('bolt')}></span></span>
              <span data-i18n="card.media.live">Live Streaming</span>
            </span>
            <span class="fest-arrow" style={svg('arrow-right')}></span>
          </a>
        </div>
      </div>

      <!-- 4 · RESULTS -->
      <div class="fest-card">
        <div class="fest-header banner-orange">
          <h3 class="fest-title" data-i18n="card.results.title">Results</h3>
          <span class="fest-subtitle" data-i18n="card.results.sub">Official Government Portal</span>
          <span class="fest-watermark" style={svg('clipboard-check')}></span>
        </div>
        <div class="fest-body">
          <a class="fest-action-item" href="https://kalolsavam.kerala.gov.in/" target="_blank" rel="noopener" style="height: 100%; justify-content: center; flex-direction: column; gap: 0.5rem; padding: 2rem 1rem; text-align: center;">
            <span class="fest-item-icon c-amber" style="margin: 0 0 0.5rem 0; width: 3rem; height: 3rem; border-radius: 50%;"><span class="icn" style={svg('clipboard-check')}></span></span>
            <span style="font-size: 1.1rem; font-weight: 800; color: var(--brand);" data-i18n="card.results.check">Check Official Results</span>
            <span class="text-muted xs" style="margin-top: 0.2rem;" data-i18n="card.results.hint">Tap to open the government portal</span>
          </a>
        </div>
      </div>

      <!-- 5 · TRANSPORTATION -->
      <div class="fest-card">
        <div class="fest-header banner-purple">
          <h3 class="fest-title" data-i18n="card.trans.title">Transportation</h3>
          <span class="fest-subtitle" data-i18n="card.trans.sub">Module 06 · Bus &amp; Auto</span>
          <span class="fest-watermark" style={svg('bus')}></span>
        </div>
        <div class="fest-body">
          <a class="fest-action-item" href={url('/transportation-bus')}>
            <span class="left">
              <span class="fest-item-icon c-blue"><span class="icn" style={svg('bus')}></span></span>
              <span data-i18n="card.trans.bus">Bus Timings</span>
            </span>
            <span class="fest-arrow" style={svg('arrow-right')}></span>
          </a>
          <a class="fest-action-item" href={url('/transportation-auto')}>
            <span class="left">
              <span class="fest-item-icon c-emerald"><span class="icn" style={svg('car')}></span></span>
              <span data-i18n="card.trans.auto">Auto Drivers</span>
            </span>
            <span class="fest-arrow" style={svg('arrow-right')}></span>
          </a>
          <a class="fest-action-item" href={url('/transportation')}>
            <span class="left">
              <span class="fest-item-icon c-indigo"><span class="icn" style={svg('map-pin')}></span></span>
              <span data-i18n="card.trans.all">All Travel Options</span>
            </span>
            <span class="fest-arrow" style={svg('arrow-right')}></span>
          </a>
        </div>
      </div>

      <!-- 6 · HELP & MEDICAL -->
      <div class="fest-card">
        <div class="fest-header banner-rose">
          <h3 class="fest-title" data-i18n="card.help.title">Help &amp; Medical</h3>
          <span class="fest-subtitle" data-i18n="card.help.sub">Module 05 · Emergency Directory</span>
          <span class="fest-watermark" style={svg('phone')}></span>
        </div>
        <div class="fest-body">
          <a class="fest-action-item" href={url('/help')}>
            <span class="left">
              <span class="fest-item-icon c-rose"><span class="icn" style={svg('medical')}></span></span>
              <span data-i18n="card.help.firstaid">First Aid</span>
            </span>
            <span class="fest-arrow" style={svg('arrow-right')}></span>
          </a>
          <a class="fest-action-item" href={url('/help')}>
            <span class="left">
              <span class="fest-item-icon c-amber"><span class="icn" style={svg('building')}></span></span>
              <span data-i18n="card.help.convener">Convener Desk</span>
            </span>
            <span class="fest-arrow" style={svg('arrow-right')}></span>
          </a>
        </div>
      </div>

    </div>

    <!-- Meet the Team & Venue Information Cards (inside main-container) -->
    <div class="grid-2" style="margin-top: 2.5rem; gap: 1.5rem; align-items: stretch;">
      <!-- Meet the Team Card -->
      <div class="fest-card">
        <div class="fest-header banner-indigo" style="background: linear-gradient(135deg, #4f46e5, #3730a3);">
          <h3 class="fest-title" data-i18n="card.dev.title">Meet the Developers &amp; Volunteers</h3>
          <span class="fest-subtitle" data-i18n="card.dev.sub">Platform Creators &amp; Backstage Crew</span>
          <span class="fest-watermark" style={`--icon-url:url('${BASE}assets/svg/user.svg')`}></span>
        </div>
        <div class="fest-body">
          <p class="text-muted sm" style="margin-bottom: 1rem;" data-i18n="card.dev.desc">Choose an option below to explore the team and backstage crew behind this platform.</p>
          <div class="grid-2" style="gap: 1rem;">
            <a href={url('/developers#developers')} class="fest-action-item">
              <span class="left">
                <span class="fest-item-icon c-indigo"><span class="icn" style={`--icon-url:url('${BASE}assets/svg/user.svg')`}></span></span>
                <span data-i18n="card.dev.devbtn">Meet Developers</span>
              </span>
              <span class="fest-arrow" style={`--icon-url:url('${BASE}assets/svg/arrow-right.svg')`}></span>
            </a>
            <a href={url('/developers#volunteers')} class="fest-action-item">
              <span class="left">
                <span class="fest-item-icon c-emerald"><span class="icn" style={`--icon-url:url('${BASE}assets/svg/users.svg')`}></span></span>
                <span data-i18n="card.dev.volbtn">Meet Volunteers</span>
              </span>
              <span class="fest-arrow" style={`--icon-url:url('${BASE}assets/svg/arrow-right.svg')`}></span>
            </a>
          </div>
        </div>
      </div>

      <!-- Venue Information / Location Card -->
      <div class="fest-card" style="padding: 1.75rem; display: flex; flex-direction: column; gap: 1.25rem; align-items: flex-start; justify-content: space-between; height: 100%;">
        <div>
          <span class="badge-gov" style="margin-bottom: 0.5rem;" data-i18n="card.venue.badge">Event Venue Location</span>
          <h3 class="card-title" style="margin-bottom: 0.35rem; font-family: Georgia, serif; font-size: 1.3rem;" data-i18n="card.venue.title">St. Antony's Higher Secondary School</h3>
          <p class="text-muted sm" style="margin: 0;" data-i18n="card.venue.addr">Mala, Thrissur District, Kerala — 680732</p>
        </div>
        <a href="https://maps.google.com/?q=St.+Antony's+Higher+Secondary+School+Mala+Thrissur+Kerala" target="_blank" rel="noopener" class="btn-primary ghost" style="display: inline-flex; align-items: center; gap: 0.6rem;">
          <span data-i18n="card.venue.btn">Open in Google Maps</span>
          <span class="icn" style={`--icon-url:url('${BASE}assets/svg/map-pin.svg');width:1.1rem;height:1.1rem`}></span>
        </a>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ BASE }}>
    (function(){
      'use strict';
      var index = [
        // ── STAGES & VENUES ───────────────────────────────────────
        { title: "Stage 1: St. Antony's HSS Ground", desc: "Main open-air stage on school ground · 1500 seats · Ground floor", href: "venues-stage/1", cat: "Stage 1", keys: ["stage 1", "main ground", "ground", "stage1", "1", "open air", "flag post", "canteen", "venue 1", "vedhi 1"] },
        { title: "Stage 2: HS Hall", desc: "High School main hall indoor auditorium · 400 seats · Ground floor", href: "venues-stage/2", cat: "Stage 2", keys: ["stage 2", "hs hall", "hall", "auditorium", "stage2", "2", "indoor", "principals office", "venue 2", "vedhi 2"] },
        { title: "Stage 3: GLPS Mala", desc: "Government Lower Primary School Mala stage · 200 seats · South compound", href: "venues-stage/3", cat: "Stage 3", keys: ["stage 3", "glps mala", "glps", "primary", "stage3", "3", "south gate", "venue 3", "vedhi 3"] },
        { title: "Stage 4: HSS A1 B1 Classes", desc: "Combined classrooms A1 and B1 · Higher Secondary block ground floor", href: "venues-stage/4", cat: "Stage 4", keys: ["stage 4", "hss a1 b1", "a1", "b1", "classroom", "stage4", "4", "staff room", "venue 4", "vedhi 4"] },
        { title: "Stage 5: HSS Seminar Hall", desc: "First floor seminar hall in HSS block · 150 seats · Central stairs", href: "venues-stage/5", cat: "Stage 5", keys: ["stage 5", "seminar hall", "seminar", "stage5", "5", "first floor", "1st floor", "library", "venue 5", "vedhi 5"] },
        { title: "Stage 6: Vyaapaara Bhavan", desc: "Traders' Bhavan off-campus stage · Mala Road 200m north", href: "venues-stage/6", cat: "Stage 6", keys: ["stage 6", "vyaapaara bhavan", "vyapara", "traders", "stage6", "6", "commercial", "bus stop", "venue 6", "vedhi 6"] },
        { title: "Stage 7: HSS 1st Floor Class", desc: "First-floor classroom stage Room 1F-A · HSS East staircase", href: "venues-stage/7", cat: "Stage 7", keys: ["stage 7", "hss 1st floor", "1f-a", "stage7", "7", "science lab", "east stairs", "venue 7", "vedhi 7"] },
        { title: "Stage 8: HS 9E Class", desc: "Classroom 9E in High School block ground floor", href: "venues-stage/8", cat: "Stage 8", keys: ["stage 8", "hs 9e", "9e", "ninth e", "stage8", "8", "class 9", "venue 8", "vedhi 8"] },
        { title: "Stage 9: HS Arabic Class", desc: "Arabic classroom in High School block corridor end", href: "venues-stage/9", cat: "Stage 9", keys: ["stage 9", "arabic class", "arabic room", "stage9", "9", "corridor end", "venue 9", "vedhi 9"] },
        { title: "Live Stages & Real-time Chest Numbers", desc: "Live stage statuses, current performers, delays, and queue orders", href: "venues-live", cat: "Live", keys: ["live", "current", "now", "chest number", "chest", "queue", "on stage", "running", "paused", "tracker", "delay", "next"] },
        { title: "Venue Map & Walking Directions", desc: "Blueprints, landmarks, accessibility and directions for all 9 stages", href: "venues-location", cat: "Location", keys: ["map", "location", "blueprint", "directions", "where is", "route", "campus map", "accessibility", "wheelchair", "blocks"] },
        { title: "Find Venue by Item Code or Name", desc: "Lookup any competition item code, venue location, day, and timings", href: "venues-find", cat: "Search", keys: ["find by item", "item code", "event code", "schedule", "timing", "when", "which stage", "program list"] },

        // ── FACILITIES ───────────────────────────────────────────
        { title: "Green Rooms (G1 – G6)", desc: "Dressing and makeup rooms · Boys (G1-G2), Girls (G3-G4), Team (G5-G6)", href: "facilities-green-room", cat: "Facilities", keys: ["green room", "greenroom", "dressing room", "makeup", "costume", "change", "changing", "mirror", "g1", "g2", "g3", "g4", "g5", "g6", "annex"] },
        { title: "Toilet & Washroom Blocks", desc: "Separate washrooms for boys, girls, and staff across Blocks A, B, and C", href: "facilities-toilet", cat: "Facilities", keys: ["toilet", "toilets", "washroom", "washrooms", "bathroom", "restroom", "urinal", "latrine", "block a", "block b", "block c", "water closet", "wc"] },
        { title: "Drinking Water Stations", desc: "4 RO purified drinking water stations across campus grounds", href: "facilities", cat: "Facilities", keys: ["drinking water", "water", "ro water", "dispenser", "thanni", "vellam", "filtered"] },
        { title: "Dining Hall (Oottupura)", desc: "Free meals for participants & accompanying teachers · Lunch 12:30–14:30", href: "facilities", cat: "Facilities", keys: ["dining", "food", "lunch", "meals", "oottupura", "canteen", "mess", "rice", "curry", "eating"] },

        // ── RESULTS & COMPETITIONS ──────────────────────────────
        { title: "Official Results Portal", desc: "Access verified state results, scorecards, points, and standings", href: "results", cat: "Results", keys: ["results", "result", "scores", "marks", "grades", "first", "second", "third", "rank", "winner", "points", "a grade", "status"] },
        { title: "Off Stage Results", desc: "Pencil Drawing, Painting, Collage, Cartoon, Clay Modeling, Essay, Poetry", href: "results-offstage", cat: "Results", keys: ["off stage", "drawing", "pencil drawing", "chithra", "painting", "collage", "cartoon", "clay modeling", "essay", "story", "poem", "writing", "off-stage"] },
        { title: "Individual Stage Results", desc: "Bharathanatyam, Mohiniyattam, Light Music, Classical, Elocution, Monoact", href: "results-individual", cat: "Results", keys: ["individual", "bharathanatyam", "mohiniyattam", "kuchipudi", "kathakali", "music", "song", "light music", "classical music", "elocution", "monoact", "mimicry", "dance", "thullal", "prasangam"] },
        { title: "Group Stage Results", desc: "Oppana, Margamkali, Nadan Pattu, Group Dance, Drama, Thiruvathira, Skit", href: "results-group", cat: "Results", keys: ["group", "oppana", "margamkali", "nadan pattu", "folk song", "group dance", "drama", "thiruvathira", "kolkali", "daffmuttu", "vanchipattu", "skit", "mime"] },

        // ── TRANSPORTATION ───────────────────────────────────────
        { title: "Bus Departures & Timings", desc: "KSRTC & Private departures from Mala Stand · Thrissur, Chalakudy, Kodungallur", href: "transportation-bus", cat: "Transport", keys: ["bus", "buses", "ksrtc", "bus timing", "bus stand", "chalakudy", "thrissur", "kodungallur", "annamanada", "route", "trip", "fast passenger", "ordinary"] },
        { title: "Verified Auto Drivers", desc: "Direct phone directory of local auto-rickshaws standby at Mala Junction", href: "transportation-auto", cat: "Transport", keys: ["auto", "autorickshaw", "rickshaw", "driver", "taxi", "cab", "anil", "shibu", "suresh", "manoj", "varghese", "auto stand", "call auto"] },
        { title: "All Transportation Options", desc: "Complete travel guide, bus timings, and auto-rickshaw contacts", href: "transportation", cat: "Transport", keys: ["transport", "travel", "how to reach", "railway", "train", "station", "junction", "ride"] },

        // ── EMERGENCY & HELP ─────────────────────────────────────
        { title: "Medical Unit & 24/7 First Aid", desc: "Campus medical post · Nursing staff, oxygen, ambulance ", href: "help", cat: "Emergency", keys: ["medical", "first aid", "doctor", "ambulance", "nurse", "hospital", "sick", "injury", "pain", "tablet", "emergency", "health", "casualty", "call medical"] },
        { title: "General Convener & Control Desk", desc: "Official festival convener, chest inquiries, disputes ", href: "help", cat: "Emergency", keys: ["convener", "convenor", "control room", "inquiry", "help desk", "emergency", "complaint", "organizer", "contact", "call convener"] },

        // ── MEDIA & ABOUT ────────────────────────────────────────
        { title: "Stage Photos Gallery", desc: "High-resolution festival stage performance photographs", href: "media", cat: "Media", keys: ["photos", "photo", "pic", "pictures", "gallery", "images", "media room", "downloads"] },
        { title: "Main Stage Live Streaming", desc: "Watch live video telecast of Main Stage competitions online", href: "media", cat: "Media", keys: ["live stream", "streaming", "watch online", "youtube", "video", "telecast", "broadcast", "channel"] },
        { title: "Developers & Web Volunteers", desc: "Meet the student architecture team and operations volunteers", href: "developers", cat: "About", keys: ["developers", "team", "volunteers", "who made", "architect", "credit", "students", "developer"] }
      ];

      // Synonym mapping
      var SYNONYMS = {
        "bathroom": ["toilet", "washroom"],
        "latrine": ["toilet", "washroom"],
        "wc": ["toilet"],
        "restroom": ["toilet"],
        "urinal": ["toilet"],
        "canteen": ["dining", "food", "oottupura"],
        "lunch": ["dining", "food", "oottupura"],
        "meals": ["dining", "food", "oottupura"],
        "eat": ["dining", "food"],
        "rice": ["dining", "food"],
        "thanni": ["water", "drinking"],
        "vellam": ["water", "drinking"],
        "doctor": ["medical", "first aid", "help"],
        "ambulance": ["medical", "first aid", "help"],
        "hospital": ["medical", "help"],
        "nurse": ["medical", "first aid"],
        "injury": ["medical", "first aid"],
        "sick": ["medical"],
        "makeup": ["green room"],
        "costume": ["green room"],
        "dressing": ["green room"],
        "changing": ["green room"],
        "ksrtc": ["bus", "transportation"],
        "auto": ["transportation", "autorickshaw"],
        "taxi": ["auto", "transportation"],
        "winner": ["results"],
        "score": ["results"],
        "marks": ["results"],
        "grade": ["results"],
        "pics": ["photos", "media"],
        "video": ["live stream", "media"],
        "stream": ["live stream", "media"]
      };

      var input = document.getElementById('global-search');
      var dropdown = document.getElementById('search-results-dropdown');
      var selectedIdx = -1;
      var currentMatches = [];

      if (!input || !dropdown) return;

      function esc(s){
        return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){
          return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
        });
      }

      function highlight(text, queryTokens){
        var str = esc(text);
        if (!queryTokens.length) return str;
        var re = new RegExp('(' + queryTokens.map(function(t){ return t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }).join('|') + ')', 'gi');
        return str.replace(re, '<mark>$1</mark>');
      }

      function computeScore(item, tokens, rawQ){
        var score = 0;
        var titleLower = item.title.toLowerCase();
        var descLower = item.desc.toLowerCase();
        var catLower = item.cat.toLowerCase();
        var keys = item.keys || [];

        // Exact match boosts
        if (titleLower === rawQ) score += 300;
        else if (titleLower.indexOf(rawQ) === 0) score += 150;
        else if (titleLower.indexOf(rawQ) > 0) score += 70;

        for (var i = 0; i < tokens.length; i++){
          var t = tokens[i];
          if (!t) continue;

          // Check title
          if (titleLower.indexOf(t) === 0) score += 50;
          else if (titleLower.indexOf(' ' + t) >= 0) score += 35;
          else if (titleLower.indexOf(t) > 0) score += 20;

          // Check keywords
          for (var k = 0; k < keys.length; k++){
            var key = keys[k];
            if (key === t) score += 60;
            else if (key.indexOf(t) === 0) score += 30;
            else if (key.indexOf(t) > 0) score += 15;
          }

          // Check description & category
          if (descLower.indexOf(t) >= 0) score += 12;
          if (catLower.indexOf(t) >= 0) score += 25;
        }
        return score;
      }

      function search(raw){
        var clean = raw.trim().toLowerCase();
        if (!clean){
          dropdown.classList.add('hidden');
          dropdown.innerHTML = '';
          currentMatches = [];
          selectedIdx = -1;
          return;
        }

        var tokens = clean.split(/\s+/).filter(Boolean);
        // Expand tokens with synonyms
        var expandedTokens = tokens.slice();
        tokens.forEach(function(t){
          if (SYNONYMS[t]){
            SYNONYMS[t].forEach(function(syn){
              if (expandedTokens.indexOf(syn) < 0) expandedTokens.push(syn);
            });
          }
        });

        var scored = [];
        for (var i = 0; i < index.length; i++){
          var item = index[i];
          var s = computeScore(item, expandedTokens, clean);
          if (s > 0){
            scored.push({ item: item, score: s });
          }
        }

        // Sort by highest relevance score
        scored.sort(function(a, b){ return b.score - a.score; });

        currentMatches = scored.slice(0, 7).map(function(x){ return x.item; });
        selectedIdx = currentMatches.length ? 0 : -1;

        if (!currentMatches.length){
          dropdown.innerHTML = '<div style="padding:1rem;color:var(--muted);font-size:.92rem;text-align:center">No exact match found. Try searching a stage number, item name, bus, or facility.</div>';
          dropdown.classList.remove('hidden');
          return;
        }

        dropdown.innerHTML = currentMatches.map(function(m, idx){
          var fullHref = BASE + m.href.replace(/^\/+/, '');
          var isSelected = idx === selectedIdx ? ' selected' : '';
          return '<a href="' + fullHref + '" class="search-result-item' + isSelected + '" data-idx="' + idx + '">' +
            '<div style="min-width:0;flex:1">' +
              '<div style="display:flex;align-items:center;gap:.6rem;margin-bottom:.2rem">' +
                '<span style="font-size:.7rem;padding:.15rem .55rem;background:var(--bg-alt);border:1px solid var(--border);border-radius:999px;color:var(--brand);font-weight:700">' + esc(m.cat) + '</span>' +
                '<strong style="font-size:.97rem;color:var(--text-heading);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + highlight(m.title, tokens) + '</strong>' +
              '</div>' +
              '<div style="font-size:.82rem;color:var(--muted);line-height:1.4">' + highlight(m.desc, tokens) + '</div>' +
            '</div>' +
            '<span style="font-size:1.1rem;color:var(--subtle);margin-left:.5rem">&rarr;</span>' +
          '</a>';
        }).join('');
        dropdown.classList.remove('hidden');
      }

      function updateSelection(){
        var items = dropdown.querySelectorAll('.search-result-item');
        items.forEach(function(el, i){
          el.classList.toggle('selected', i === selectedIdx);
        });
        if (items[selectedIdx]) {
          items[selectedIdx].scrollIntoView({ block: 'nearest' });
        }
      }

      input.addEventListener('input', function(){
        search(input.value);
      });

      // Keyboard navigation
      input.addEventListener('keydown', function(ev){
        if (dropdown.classList.contains('hidden') || !currentMatches.length) return;

        if (ev.key === 'ArrowDown'){
          ev.preventDefault();
          selectedIdx = (selectedIdx + 1) % currentMatches.length;
          updateSelection();
        } else if (ev.key === 'ArrowUp'){
          ev.preventDefault();
          selectedIdx = (selectedIdx - 1 + currentMatches.length) % currentMatches.length;
          updateSelection();
        } else if (ev.key === 'Enter'){
          ev.preventDefault();
          if (selectedIdx >= 0 && currentMatches[selectedIdx]){
            var targetUrl = BASE + currentMatches[selectedIdx].href.replace(/^\/+/, '');
            window.location.href = targetUrl;
          }
        } else if (ev.key === 'Escape'){
          dropdown.classList.add('hidden');
          input.blur();
        }
      });

      // Quick shortcut: Press '/' anywhere to focus search
      document.addEventListener('keydown', function(ev){
        if (ev.key === '/' && document.activeElement !== input && !['input','textarea','select'].includes(document.activeElement.tagName.toLowerCase())){
          ev.preventDefault();
          input.focus();
          input.select();
        }
      });

      // Click outside to dismiss
      document.addEventListener('click', function(ev){
        if (!input.contains(ev.target) && !dropdown.contains(ev.target)){
          dropdown.classList.add('hidden');
        }
      });
    })();
  </script>
</BaseLayout>
